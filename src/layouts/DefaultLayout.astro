---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { RESOURCES } from "../config";
import "../styles/global.css";

// @ts-ignore
import Background from "../assets/background_dark.png?format=webp&w=800";
// @ts-ignore
import metaImage from "../assets/largehero.png?format=webp";

const {
  title,
  lang = "de",
  meta_description = "BaggelMC – eine Minecraft server community",
  keywords = "Minecraft, Server, BaggelMC, BuildMC, Minigames, Community",
  titleSuffix = "BaggelMC",
  enableAlpine = true,
  extraHead = null,
} = Astro.props;

const fullTitle = title ? `${title} | ${titleSuffix}` : titleSuffix;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{fullTitle}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#d6904f" />

    <meta name="description" content={meta_description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="BaggelMC" />
    <link rel="canonical" href={Astro.url ?? "https://baggelmc.de"} />

    <meta name="robots" content="index,follow" />
    <meta name="revisit-after" content="8 days" />

    <meta property="og:site_name" content="BaggelMC" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={meta_description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url ?? "https://baggelmc.de"} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:locale" content={lang} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={meta_description} />
    <meta name="twitter:image" content={metaImage} />

    <link href={RESOURCES.fontURL} rel="stylesheet" />

    {enableAlpine && <script src="https://unpkg.com/alpinejs" defer></script>}

    <slot name="head" />
  </head>

  <body
    class="relative min-h-screen text-text font-sans flex flex-col overflow-x-hidden bg-background"
    style={`--page-bg: url(${Background});`}
  >
    <div class="background-image pointer-events-none" aria-hidden="true"></div>

    <Header title="BaggelMC" />
    <main class="grow relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>

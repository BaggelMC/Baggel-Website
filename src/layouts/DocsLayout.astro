---
import DefaultLayout from "./DefaultLayout.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsVersionSwitcher from "../components/docs/DocsVersionSwitcher.astro";
import DocsLangSwitcher from "../components/docs/DocsLangSwitcher.astro";
import { buildNav } from "../scripts/docs/docs";
import type { Version } from "../scripts/docs/docs-config";

interface Props {
  title: string;
  description?: string;
  lang: string;
  version: Version;
  slug: string;
  deprecated?: boolean;
  deprecationMessage?: string;
  langFallback?: boolean;
  inherited?: boolean;
}

const {
  title,
  description,
  lang,
  version,
  slug,
  deprecated = false,
  deprecationMessage,
  langFallback = false,
  inherited = false,
} = Astro.props;

const nav = await buildNav(lang, version);
---

<DefaultLayout
  title={title}
  lang={lang}
  meta_description={description ?? `${title} — Documentation`}
  titleSuffix="Docs · BaggelMC"
>
  <div class="docs-root">
    <!-- Sidebar -->
    <aside class="docs-sidebar">
      <div class="docs-sidebar-inner">
        <div class="docs-switchers">
          <DocsVersionSwitcher
            lang={lang}
            currentVersion={version}
            currentSlug={slug}
          />
          <DocsLangSwitcher lang={lang} version={version} slug={slug} />
        </div>
        <DocsSidebar
          nav={nav}
          currentSlug={slug}
          lang={lang}
          version={version}
        />
      </div>
    </aside>

    <!-- Main content -->
    <main class="docs-main">
      <!-- Banners -->
      {
        langFallback && (
          <div class="docs-banner docs-banner--info">
            <span>
              Diese Seite ist noch nicht übersetzt. Du siehst die englische
              Version.
            </span>
          </div>
        )
      }
      {
        deprecated && (
          <div class="docs-banner docs-banner--warning">
            <span>
              {deprecationMessage ??
                "This page is deprecated and may be removed in a future version."}
            </span>
          </div>
        )
      }
      {
        inherited && !deprecated && (
          <div class="docs-banner docs-banner--subtle">
            <span>This page has not changed since an earlier version.</span>
          </div>
        )
      }

      <article class="docs-article prose">
        <h1>{title}</h1>
        <slot />
      </article>
    </main>
  </div>
</DefaultLayout>

<style>
  .docs-root {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: calc(100vh - var(--header-height, 64px));
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    gap: var(--space-12);
  }

  @media (max-width: 768px) {
    .docs-root {
      grid-template-columns: 1fr;
      padding: 0 var(--space-4);
    }
    .docs-sidebar {
      display: none;
    }
  }

  /* Sidebar */
  .docs-sidebar {
    border-right: 1px solid
      color-mix(in srgb, var(--color-separator) 30%, transparent);
  }

  .docs-sidebar-inner {
    position: sticky;
    top: calc(var(--header-height, 64px) + var(--space-8));
    padding: var(--space-8) var(--space-6) var(--space-8) 0;
    max-height: calc(100vh - var(--header-height, 64px) - var(--space-16));
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .docs-switchers {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-separator) 30%, transparent);
  }

  /* Main */
  .docs-main {
    padding: var(--space-8) 0 var(--space-16);
    min-width: 0;
  }

  /* Banners */
  .docs-banner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-radius: 6px;
    margin-bottom: var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  .docs-banner--info {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    color: var(--color-primary);
  }

  .docs-banner--warning {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
  }

  .docs-banner--subtle {
    background: color-mix(in srgb, var(--color-text-100) 15%, transparent);
    border: 1px solid
      color-mix(in srgb, var(--color-separator) 25%, transparent);
    color: var(--color-text-50);
  }

  /* Prose styles for markdown content */
  .prose {
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    max-width: 72ch;
  }

  .prose :global(h1) {
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: var(--space-8);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-separator) 30%, transparent);
    padding-bottom: var(--space-4);
  }

  .prose :global(h2) {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    color: var(--color-text);
    font-weight: 600;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .prose :global(h3) {
    font-size: var(--text-base);
    line-height: var(--leading-base);
    color: var(--color-text);
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-accent) 40%,
      transparent
    );
    text-underline-offset: 3px;
    transition: color var(--transition-duration-fast)
      var(--transition-timing-default);
  }

  .prose :global(a:hover) {
    color: var(--color-primary);
  }

  .prose :global(code) {
    font-family: var(--font-sans);
    font-size: 0.9em;
    background: color-mix(in srgb, var(--color-background-10) 80%, transparent);
    border: 1px solid
      color-mix(in srgb, var(--color-separator) 25%, transparent);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    color: var(--color-primary);
  }

  .prose :global(pre) {
    background: var(--color-background-10);
    border: 1px solid
      color-mix(in srgb, var(--color-separator) 25%, transparent);
    border-radius: 8px;
    padding: var(--space-5);
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-5);
    margin: var(--space-6) 0;
    color: var(--color-text-50);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: var(--text-xs);
  }

  .prose :global(th) {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-separator) 40%, transparent);
    color: var(--color-primary);
    font-weight: 600;
  }

  .prose :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-separator) 15%, transparent);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid
      color-mix(in srgb, var(--color-separator) 30%, transparent);
    margin: var(--space-8) 0;
  }
</style>

---
import "../styles/index.css";
import Headline from "../components/Headline.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Separator from "../components/Separator.astro";
import CopyServerAddressButton from "../components/CopyServerAddressButton.astro";

//@ts-ignore
import TextLogo from "../assets/largehero.png?format=webp&w=1000";

import DirtTexture from "../assets/images/textures/dirt.png";
import PlayButtonTexture from "../assets/images/textures/play.png";
import PlayButtonHoverTexture from "../assets/images/textures/play_hover.png";
import Click from "../assets/audio/click.ogg";
//@ts-ignore
import Screenshot from "../assets/server_status_background_1.png?format=webp&w=100";

import { LINKS } from "../config";

// IMAGES

//@ts-ignore
import ImageDuelsLow from "../assets/images/gamemodes/1v1.png?format=webp&w=100";
//@ts-ignore
import ImageDuelsMed from "../assets/images/gamemodes/1v1.png?format=webp&w=800";
//@ts-ignore
import ImageDuelsHigh from "../assets/images/gamemodes/1v1.png?format=png&w=1400";

//@ts-ignore
import ImageFFALow from "../assets/images/gamemodes/FFA.png?format=webp&w=100";
//@ts-ignore
import ImageFFAMed from "../assets/images/gamemodes/FFA.png?format=webp&w=800";
//@ts-ignore
import ImageFFAHigh from "../assets/images/gamemodes/FFA.png?format=png&w=1400";

//@ts-ignore
import ImageFireballLow from "../assets/images/gamemodes/fireball.png?format=webp&w=100";
//@ts-ignore
import ImageFireballMed from "../assets/images/gamemodes/fireball.png?format=webp&w=800";
//@ts-ignore
import ImageFireballHigh from "../assets/images/gamemodes/fireball.png?format=png&w=1400";

//@ts-ignore
import ImageTNTTagLow from "../assets/images/gamemodes/tnttag.png?format=webp&w=100";
//@ts-ignore
import ImageTNTTagMed from "../assets/images/gamemodes/tnttag.png?format=webp&w=800";
//@ts-ignore
import ImageTNTTagHigh from "../assets/images/gamemodes/tnttag.png?format=png&w=1400";

import Pronounciation from "../assets/audio/baggel.mp3";

const finishedGames = [
  {
    name: "Duels 1v1",
    description:
      "Tritt gegen einen anderen Spieler in intensiven, schnellen PvP-Duellen an. Wähle dein Kit, schärfe deine Reflexe und kämpfe um den Sieg in unseren Arenen! Nur die Besten werden bestehen.",
    images: [ImageDuelsLow, ImageDuelsMed, ImageDuelsHigh],
    image_alt:
      "Zwei Spieler in Diamantrüstungen kämpfen mit Diamantschwertern und -schilden in einer felsigen Arena.",
    tags: ["1v1", "PvP"],
  },
  {
    name: "Knockback FFA",
    description:
      "Keine Teams, keine Gnade! Jeder Spieler für sich selbst! Springe in chaotische Free-for-All-Kämpfe, bei denen schnelles Denken und Geschick entscheiden, wer das Schlachtfeld dominiert.",
    images: [ImageFFALow, ImageFFAMed, ImageFFAHigh],
    image_alt:
      "Zwei Spieler kämpfen in einer Ebenenlandschaft mit Lederrüstungen und Knockback Sticks.",
    tags: ["FFA", "Chaos"],
  },
  {
    name: "Fireball Fight",
    description:
      "Schieße, weiche aus und kämpfe dich mit Explosionen zum Sieg! Nutze Präzision und Timing, um deine Gegner mit gut gezielten Feuerbällen von der Karte zu befördern. Ein Treffer kann alles ändern.",
    images: [ImageFireballLow, ImageFireballMed, ImageFireballHigh],
    image_alt:
      "Zwei Spieler kämpfen. Einer befindet sich auf einem hohen Turm in blauer Rüstung und schleudert einen Feuerball auf einen Spieler in roter Rüstung.",
    tags: ["Ranged", "Skillshots"],
  },
  {
    name: "Hot Potato",
    description:
      "Du hast eine tickende Zeitbombe! Gib sie schnell weiter, bevor sie explodiert! Wer am Ende die Bombe hat, verliert. Geschwindigkeit und Strategie entscheiden über Sieg oder Niederlage.",
    images: [ImageTNTTagLow, ImageTNTTagMed, ImageTNTTagHigh],
    image_alt:
      "Ein Spieler mit einem TNT-Kopf jagt einen anderen brennenden Spieler durch eine enge Arena.",

    tags: ["Team", "Survival"],
  },
];

const unfinishedGames = [
  {
    name: "Pillars of Fortune",
    description:
      "Du bist auf einer winzigen Säule gestrandet, die im Nichts schwebt. Alle paar Sekunden gibt dir das Schicksal zufällige Gegenstände, manchmal hilfreich, manchmal tödlich. Überlebe alle anderen in diesem Spiel aus purem Chaos und Glück!",

    icon: "pillar",
  },
  {
    name: "Chess",
    description:
      "Das klassische Strategiespiel im Minecraft-Stil. Bewege deine Armee über das Brett, plane jeden Angriff und setze deinen Gegner schachmatt!",

    icon: "chess",
  },
  {
    name: "TNT Run",
    description:
      "Beweg dich oder falle! Der Boden verschwindet unter deinen Füßen, während du rennst. Ein falscher Schritt und das Spiel ist vorbei. Überlebe alle anderen in diesem explosiven Test für Reflexe und Kontrolle.",
    icon: "tnt",
  },
  {
    name: "Baggel Clicker",
    description:
      "Jeder Klick zählt! Sammle Münzen, kaufe Upgrades und klettere die Bestenliste hinauf in diesem süchtig machenden Idle-Clicker-Erlebnis, inspiriert von Cookie Clicker, aber mit diesem Baggel-Flair.",
    icon: "bagel",
  },
  {
    name: "Replica",
    description:
      "Pass genau auf! Eine Struktur erscheint und es liegt an dir, sie perfekt nachzubauen. Geschwindigkeit und Präzision entscheiden, wer als Meisterbauer herrscht.",
    icon: "replica",
  },
  {
    name: "SpeedCrafter",
    description:
      "Bastele oder werde gebastelt! Rase darum, zufällige Rezepte so schnell wie möglich zu vervollständigen. Je schneller deine Hände und dein Gedächtnis, desto höher deine Punktzahl und dein Recht zu prahlen.",
    icon: "craft",
  },
  {
    name: "Cow Pong",
    description:
      "Klassisches Pong... aber mit Kühen! Schnell zu sein ist der Schlüssel! (Ich schwöre, die Kühe mögen es!)",
    icon: "pong",
  },
];

// Hand-drawn style line icons for games that don't have artwork yet.
// Each is a small sketch-like SVG, colored via the game's accent through `currentColor`.
const ICONS: Record<string, string> = {
  pillar: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 40h20"/><path d="M16 40V16h16v24"/><path d="M13 16h22"/><path d="M24 4v5"/><path d="M18 7l2.5 2.5"/><path d="M30 7l-2.5 2.5"/></svg>`,
  chess: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M24 6v7"/><path d="M20 10h8"/><path d="M18 18c0 3 2 5 2 5h8s2-2 2-5-3-4-6-4-6 1-6 4z"/><path d="M16 40c0-6 3-9 3-9h10s3 3 3 9"/><path d="M14 40h20"/></svg>`,
  tnt: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="14" y="16" width="20" height="16" rx="1.5"/><path d="M24 16v-4"/><path d="M24 12c2-2 2-4 0-6"/><path d="M14 24h20"/><path d="M9 38l6-4 4 4 6-5 6 3 6-4" opacity="0.55"/></svg>`,
  bagel: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="21" cy="24" r="12"/><circle cx="21" cy="24" r="4.5"/><path d="M34.5 11.5l3.5 3.5"/><path d="M39 18.5h5"/><path d="M35 24.5h4.5"/></svg>`,
  replica: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="9" width="18" height="18" rx="2" stroke-dasharray="3 3.5"/><rect x="23" y="21" width="18" height="18" rx="2"/><path d="M28 30l3 3 6-6"/></svg>`,
  craft: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="24" height="24" rx="2"/><path d="M7 15h24M7 23h24M15 7v24M23 7v24"/><path d="M37 13l-6 10h5l-6 10" stroke-width="3"/></svg>`,
  pong: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 8v32"/><path d="M39 8v32"/><circle cx="24" cy="24" r="4" fill="currentColor" stroke="none"/><path d="M17 14c2 1 3 3 2 5" opacity="0.55"/><path d="M31 34c-2-1-3-3-2-5" opacity="0.55"/></svg>`,
};
---

<DefaultLayout>
  <div
    class="max-w-5xl mx-auto px-4 sm:px-8 py-16 sm:py-20 text-text font-sans space-y-20"
  >
    <img
      src={TextLogo}
      class="mx-auto h-30 md:h-80 object-cover"
      alt="Baggel Logo"
    />

    <!-- Server Info Section -->
    <section
      class="info-section bg-background-10 relative max-w-xl mx-auto text-left text-text rounded-4xl shadow-lg border border-background-50 hover:border-accent transition-all duration-500 overflow-hidden"
    >
      <div class="absolute inset-0 h-67 overflow-hidden">
        <img
          src={Screenshot}
          alt="Server Screenshot"
          class="blur-xs w-full scale-105 h-full object-cover object-center opacity-40 group-hover:opacity-50 transition-opacity duration-500"
        />
      </div>

      <!-- Content Overlay -->
      <div
        class="relative z-10 px-6 sm:px-8 md:px-10 py-10 text-center space-y-4 bg-transparent"
      >
        <h2
          class="text-xl sm:text-2xl font-bold tracking-wide text-primary text-center"
        >
          Server-Status
        </h2>

        <ul class="space-y-2 text-base">
          <li>
            <strong>Status:</strong>
            <span id="server-status" class="text-neutral-400">Lädt...</span>
          </li>
          <li>
            <strong>Spieler:</strong>
            <span id="server-players" class="text-neutral-400">0 / 0</span>
          </li>
        </ul>

        <div class="mt-4 text-center hidden md:block">
          <div
            class="motd-box mt-2 items-center gap-4 font-minecraft text-xs group inline-flex"
            style={`background-image: url('${DirtTexture.src}');`}
          >
            <div
              class="icon-container relative w-16 h-16 shrink-0 hidden select-none"
              id="serverIconContainer"
            >
              <img
                id="server-icon"
                alt="Server Icon"
                class="icon-image w-full h-full object-cover"
              />
              <img
                src={PlayButtonTexture.src}
                alt="Play Button Overlay"
                class="icon-overlay absolute inset-0 w-full h-full object-cover"
              />
              <img
                src={PlayButtonHoverTexture.src}
                alt="Play Button Hover Overlay"
                class="icon-overlay-hover absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100"
              />
              <audio id="clickAudio" src={Click}></audio>
            </div>

            <span id="server-motd" class="text-text-50">Lädt MOTD...</span>
          </div>
        </div>

        <div class="mt-4 flex justify-center">
          <CopyServerAddressButton
            text="Kopiere Server-Adresse"
            copyText={LINKS.server_address}
          />
        </div>
      </div>
    </section>

    <section
      class="definition-section max-w-xl mx-auto px-6 sm:px-8 md:px-10 text-left text-text rounded-4xl bg-linear-to-br from-background-10 to-background-10 border border-background-50 hover:border-accent transition-all duration-500 shadow-lg hover:shadow-2xl py-5"
    >
      <div class="flex items-center gap-4">
        <h2
          class="text-xl sm:text-2xl font-bold italic tracking-wide text-primary mb-4"
        >
          Ba·ggel
        </h2>
        <button
          id="playAudioButton"
          class="audio-button text-text-50 hover:text-primary transition-all duration-300"
          aria-label="Play pronunciation"
        >
          <svg
            id="speakerIcon"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 32 32"
            class="w-10 h-10 sm:w-15 sm:h-15"
          >
            <path
              xmlns="http://www.w3.org/2000/svg"
              d="M20.4,2.9c-0.3-0.2-0.7-0.1-1,0.1L9.7,10H3c-0.6,0-1,0.4-1,1v10c0,0.6,0.4,1,1,1h6.7l9.7,7.1c0.2,0.1,0.4,0.2,0.6,0.2   c0.2,0,0.3,0,0.5-0.1c0.3-0.2,0.5-0.5,0.5-0.9V3.8C21,3.4,20.8,3,20.4,2.9z"
            ></path>
            <path
              xmlns="http://www.w3.org/2000/svg"
              d="M27.1,9.3c-0.4-0.4-1-0.4-1.4,0s-0.4,1,0,1.4C27.2,12.1,28,14,28,16s-0.8,3.9-2.3,5.3c-0.4,0.4-0.4,1,0,1.4   c0.2,0.2,0.5,0.3,0.7,0.3c0.2,0,0.5-0.1,0.7-0.3C29,20.9,30,18.6,30,16S29,11.1,27.1,9.3z"
            ></path>
            <path
              xmlns="http://www.w3.org/2000/svg"
              d="M24.7,12.7c-0.4-0.4-1-0.4-1.4,0.1c-0.4,0.4-0.3,1,0.1,1.4c0.5,0.5,0.8,1.2,0.8,1.9s-0.3,1.4-0.8,1.9   c-0.4,0.4-0.4,1-0.1,1.4c0.2,0.2,0.5,0.3,0.7,0.3c0.2,0,0.5-0.1,0.7-0.3c1-0.9,1.5-2.1,1.5-3.3S25.6,13.5,24.7,12.7z"
            ></path>
          </svg>
        </button>
      </div>

      <p class="text-text-50 text-lg italic mb-2">nomen</p>
      <p class="text-text-100 text-base mb-4">/ˈbeɪɡl̩/</p>
      <p class="text-lg text-text-50">
        eine <span class="text-accent">Minecraft server community</span>
      </p>

      <audio id="pronunciationAudio" src={Pronounciation}></audio>
    </section>

    <!-- Finished Games Section -->
    <section class="finished-games text-center">
      <h2 class="text-2xl font-bold mb-8 text-primary">Verfügbare Spiele</h2>

      <div class="flex flex-wrap justify-center gap-8">
        {
          finishedGames.map((game) => (
            <div
              class="tilt-card game-card w-full sm:w-[45%] lg:w-[45%] max-w-xl relative rounded-2xl overflow-hidden bg-background-10 border border-background-50 transition-colors duration-500 shadow-lg"
              style={`--accent:#d6904f`}
            >
              <div class="cursor-glow" />
              <span class="corner corner-tl" />
              <span class="corner corner-br" />

              <div class="relative z-10 h-52 sm:h-56 overflow-hidden">
                <div class="progressive-img-wrapper w-full h-full">
                  <img
                    src={game.images[0]}
                    data-images={JSON.stringify(game.images)}
                    alt={game.image_alt}
                    loading="lazy"
                    decoding="async"
                    class="progressive-img w-full h-full object-cover"
                  />
                </div>
                <span
                  class="absolute top-4 right-4 z-2 font-minecraft text-[10px] tracking-normal px-2 py-1 rounded backdrop-blur-sm"
                  style={`background:color-mix(in srgb, #d6904f 18%, transparent); color:#d6904f; border:1px solid color-mix(in srgb, #d6904f 40%, transparent);`}
                >
                  Verfügbar
                </span>
              </div>

              <div class="relative z-10 p-6 text-left space-y-3">
                <h3 class="text-xl font-bold text-primary">{game.name}</h3>
                <div class="flex flex-wrap gap-2">
                  {game.tags.map((tag) => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
                <p class="text-text-50">{game.description}</p>
              </div>

              <div class="card-shine" />
            </div>
          ))
        }
      </div>
    </section>

    <Separator />

    <!-- Coming Soon Section -->
    <section class="unfinished-games text-center">
      <h2 class="text-2xl font-bold mb-8 text-primary">Demnächst</h2>

      <div class="flex flex-wrap justify-center gap-8">
        {
          unfinishedGames.map((game) => (
            <div
              class="tilt-card game-card game-card--concept w-full sm:w-[45%] lg:w-[45%] max-w-xl relative rounded-2xl overflow-hidden bg-background-10 border-2 border-dashed border-background-50 transition-colors duration-500"
              style={`--accent:#d6904f`}
            >
              <div class="cursor-glow" />

              <div class="blueprint-grid relative z-10 h-52 sm:h-56 overflow-hidden flex items-center justify-center">
                <pre class="code-typer" aria-hidden="true" />
                <div
                  class="icon-visual w-16 h-16"
                  style={`color:#d6904f`}
                  set:html={ICONS[game.icon]}
                />
                <span
                  class="absolute top-4 right-4 z-2 font-minecraft text-[10px] tracking-normal px-2 py-1 rounded backdrop-blur-sm"
                  style={`background:color-mix(in srgb, #d6904f 18%, transparent); color:#d6904f; border:1px solid color-mix(in srgb, #d6904f 40%, transparent);`}
                >
                  In Entwicklung
                </span>
              </div>

              <div class="relative z-10 p-6 text-left space-y-3">
                <h3 class="text-xl font-bold text-primary">{game.name}</h3>
                <p class="text-text-50">{game.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Development Notice -->
    <section class="text-center max-w-2xl mx-auto">
      <Separator />
      <p class="text-text-50 text-base">
        Unser Server befindet sich derzeit in <span
          class="text-accent font-semibold">aktiver Entwicklung</span
        >.<br />
        Neue Spielmodi und Funktionen werden ständig hinzugefügt. Bleib dran!
      </p>
    </section>
  </div>
</DefaultLayout>

<script src="../scripts/index/pronounciationButton.ts"></script>

<script src="../scripts/index/serverStatus.ts"></script>

<script src="../scripts/index/progressiveImages.ts"></script>

<script src="../scripts/index/cardTilt.ts"></script>

<script src="../scripts/index/codeTyper.ts"></script>

---
import "../styles/index.css";
import Headline from "../components/Headline.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Separator from "../components/Separator.astro";
import CopyServerAddressButton from "../components/CopyServerAddressButton.astro";

//@ts-ignore
import TextLogo from "../assets/largehero.png?format=webp&w=1000";

import DirtTexture from "../assets/images/textures/dirt.png";
import PlayButtonTexture from "../assets/images/textures/play.png";
import PlayButtonHoverTexture from "../assets/images/textures/play_hover.png";
import Click from "../assets/audio/click.ogg";
//@ts-ignore
import Screenshot from "../assets/server_status_background_1.png?format=webp&w=100";

import { LINKS } from "../config";

// IMAGES

//@ts-ignore
import ImageCrystalFightLow from "../assets/images/gamemodes/Crystalfight.png?format=webp&w=100";
//@ts-ignore
import ImageCrystalFightMed from "../assets/images/gamemodes/Crystalfight.png?format=webp&w=800";
//@ts-ignore
import ImageCrystalFightHigh from "../assets/images/gamemodes/Crystalfight.png?format=png&w=1400";

//@ts-ignore
import ImageFFALow from "../assets/images/gamemodes/FFA.png?format=webp&w=100";
//@ts-ignore
import ImageFFAMed from "../assets/images/gamemodes/FFA.png?format=webp&w=800";
//@ts-ignore
import ImageFFAHigh from "../assets/images/gamemodes/FFA.png?format=png&w=1400";

//@ts-ignore
import ImagePillarsLow from "../assets/images/gamemodes/Pillars.png?format=webp&w=100";
//@ts-ignore
import ImagePillarsMed from "../assets/images/gamemodes/Pillars.png?format=webp&w=800";
//@ts-ignore
import ImagePillarsHigh from "../assets/images/gamemodes/Pillars.png?format=png&w=1400";

//@ts-ignore
import ImageLudoLow from "../assets/images/gamemodes/Ludo.png?format=webp&w=100";
//@ts-ignore
import ImageLudoMed from "../assets/images/gamemodes/Ludo.png?format=webp&w=800";
//@ts-ignore
import ImageLudoHigh from "../assets/images/gamemodes/Ludo.png?format=png&w=1400";

//@ts-ignore
import ImagePvPLow from "../assets/images/gamemodes/PvP.png?format=webp&w=100";
//@ts-ignore
import ImagePvPMed from "../assets/images/gamemodes/PvP.png?format=webp&w=800";
//@ts-ignore
import ImagePvPHigh from "../assets/images/gamemodes/PvP.png?format=png&w=1400";

//@ts-ignore
import ImageGolfLow from "../assets/images/gamemodes/Golf.png?format=webp&w=100";
//@ts-ignore
import ImageGolfMed from "../assets/images/gamemodes/Golf.png?format=webp&w=800";
//@ts-ignore
import ImageGolfHigh from "../assets/images/gamemodes/Golf.png?format=png&w=1400";

//@ts-ignore
import ImageMinigolfLow from "../assets/images/gamemodes/Minigolf.png?format=webp&w=100";
//@ts-ignore
import ImageMinigolfMed from "../assets/images/gamemodes/Minigolf.png?format=webp&w=800";
//@ts-ignore
import ImageMinigolfHigh from "../assets/images/gamemodes/Minigolf.png?format=png&w=1400";

//@ts-ignore
import ImageReplicaLow from "../assets/images/gamemodes/Replica.png?format=webp&w=100";
//@ts-ignore
import ImageReplicaMed from "../assets/images/gamemodes/Replica.png?format=webp&w=800";
//@ts-ignore
import ImageReplicaHigh from "../assets/images/gamemodes/Replica.png?format=png&w=1400";

//@ts-ignore
import ImageElytraLow from "../assets/images/gamemodes/Elytra.png?format=webp&w=100";
//@ts-ignore
import ImageElytraMed from "../assets/images/gamemodes/Elytra.png?format=webp&w=800";
//@ts-ignore
import ImageElytraHigh from "../assets/images/gamemodes/Elytra.png?format=png&w=1400";

import Pronounciation from "../assets/audio/baggel.mp3";

//@ts-ignore
import IconBedWars from "../assets/images/gamemodes/icons/bedwars.png?format=webp&w=128";
//@ts-ignore
import IconSkyWars from "../assets/images/gamemodes/icons/skywars.png?format=webp&w=128";
//@ts-ignore
import IconChess from "../assets/images/gamemodes/icons/chess.png?format=webp&w=128";
//@ts-ignore
import IconHideAndSeek from "../assets/images/gamemodes/icons/hideandseek.png?format=webp&w=128";
//@ts-ignore
import IconLasertag from "../assets/images/gamemodes/icons/lasertag.png?format=webp&w=128";
//@ts-ignore
import IconTntTag from "../assets/images/gamemodes/icons/tnttag.png?format=webp&w=128";

const finishedGames = [
  {
    name: "CrystalFight",
    description:
      "Katapultiere dich mit End-Kristallen und Respawn-Ankern über die Karte! Zerstöre das Bett deines Gegners und schalte ihn aus, bevor er dir zuvorkommt. Präzises Timing und mutige Sprünge entscheiden über Sieg oder Fall.",
    images: [ImageCrystalFightLow, ImageCrystalFightMed, ImageCrystalFightHigh],
    image_alt:
      "Ein Spieler wird durch die Explosion eines End-Kristalls über eine Arena mit Betten katapultiert.",
    tags: ["PvP", "Bett zerstören"],
  },
  {
    name: "Knockback FFA",
    description:
      "Keine Teams, keine Gnade! Jeder Spieler für sich selbst! Springe in chaotische Free-for-All-Kämpfe, bei denen schnelles Denken und Geschick entscheiden, wer das Schlachtfeld dominiert.",
    images: [ImageFFALow, ImageFFAMed, ImageFFAHigh],
    image_alt:
      "Zwei Spieler kämpfen in einer Ebenenlandschaft mit Lederrüstungen und Knockback Sticks.",
    tags: ["FFA", "Chaos"],
  },
  {
    name: "Pillars of Fortune",
    description:
      "Du spawnst auf einem Bedrock-Turm mitten im Nichts. Alle paar Sekunden gibt dir das Schicksal einen zufälligen Gegenstand, darunter eigens gebraute Custom-Potions. Improvisiere und mach das Beste aus dem, was das Glück dir gibt. Wer zuletzt übrig bleibt, gewinnt.",
    images: [ImagePillarsLow, ImagePillarsMed, ImagePillarsHigh],
    image_alt:
      "Ein Spieler steht auf einer schmalen Bedrock-Säule, die im Nichts schwebt, umgeben von treibenden Items.",
    tags: ["Chaos", "Glück"],
  },
  {
    name: "Ludo",
    description:
      "Das klassische Brettspiel, neu erfunden in Minecraft! Nutze Items, um deine Gegner zu sabotieren, und tritt in Duellen an, um zu entscheiden, wessen Spielfigur bleiben darf und wer zurück nach Hause muss.",
    images: [ImageLudoLow, ImageLudoMed, ImageLudoHigh],
    image_alt:
      "Ein farbenfrohes Ludo-Spielbrett aus Blöcken mit bunten Spielfiguren in Minecraft.",
    tags: ["Brettspiel", "Sabotage"],
  },
  {
    name: "Duels",
    description:
      "Kit-PvP in Reinform, ein echter Klassiker. Wähle dein Kit, schärfe deine Reflexe und kämpfe im 1v1 um den Sieg in unseren Arenen! Nur die Besten werden bestehen.",
    images: [ImagePvPLow, ImagePvPMed, ImagePvPHigh],
    image_alt:
      "Zwei Spieler in Rüstungen kämpfen mit Schwertern und Schilden in einer Arena.",
    tags: ["1v1", "PvP"],
  },
  {
    name: "Golf",
    description:
      "Golf, wie du es kennst, jetzt in Minecraft! Schlage den Ball mit Bedacht über liebevoll gestaltete Bahnen und versuche, mit möglichst wenigen Schlägen ins Loch zu treffen.",
    images: [ImageGolfLow, ImageGolfMed, ImageGolfHigh],
    image_alt:
      "Ein Spieler steht auf einer grünen Golfbahn aus Blöcken und zielt auf das Loch.",
    tags: ["Geschicklichkeit", "Entspannt"],
  },
  {
    name: "Minigolf",
    description:
      "Minigolf für zwischendurch! Meistere kreative, kniffelige Bahnen voller Hindernisse und Tricks und beweise, wer den ruhigsten Schwung hat.",
    images: [ImageMinigolfLow, ImageMinigolfMed, ImageMinigolfHigh],
    image_alt:
      "Eine bunte Minigolfbahn mit Hindernissen und Kurven, gebaut aus Minecraft-Blöcken.",
    tags: ["Geschicklichkeit", "Party"],
  },
  {
    name: "Replica",
    description:
      "Pass genau auf! Ein Bild erscheint und es liegt an dir, es so schnell wie möglich originalgetreu nachzubauen. Geschwindigkeit und Präzision entscheiden, wer als Meisterbauer herrscht.",
    images: [ImageReplicaLow, ImageReplicaMed, ImageReplicaHigh],
    image_alt:
      "Zwei nebeneinander stehende Bauwerke, eines als Vorlage und eines als Nachbau eines Spielers.",
    tags: ["Bauen", "Speed"],
  },
  {
    name: "Elytra Race",
    description:
      "Teste deine Flugkünste im Rennen gegen andere! Rase mit deiner Elytra durch anspruchsvolle Streckenabschnitte und Ringe und sichere dir als Erster die Ziellinie.",
    images: [ImageElytraLow, ImageElytraMed, ImageElytraHigh],
    image_alt:
      "Mehrere Spieler fliegen mit Elytren durch eine Rennstrecke aus schwebenden Ringen.",
    tags: ["Rennen", "Skill"],
  },
];

const unfinishedGames = [
  {
    name: "BedWars",
    description:
      "Verteidige dein Bett und zerstöre die deiner Gegner! Sammle Ressourcen von deinem Generator, rüste dein Team aus und kämpfe um das letzte stehende Bett.",
    icon: "bedwars",
  },
  {
    name: "SkyWars",
    description:
      "Kämpfe auf schwebenden Inseln ums Überleben! Plündere Truhen nach Ausrüstung, überbrücke die Leere und sei der letzte Spieler, der noch in der Luft steht.",
    icon: "skywars",
  },
  {
    name: "Chess",
    description:
      "Das klassische Strategiespiel im Minecraft-Stil. Bewege deine Armee über das Brett, plane jeden Angriff und setze deinen Gegner schachmatt!",
    icon: "chess",
  },
  {
    name: "Hide and Seek",
    description:
      "Verstecke dich gut oder finde alle anderen! Ein Spieler sucht, während sich der Rest als Blöcke getarnt irgendwo auf der Karte versteckt. Wer zuletzt entdeckt wird, gewinnt.",
    icon: "hideandseek",
  },
  {
    name: "Lasertag",
    description:
      "Schnapp dir deinen Blaster und ballere dich zum Sieg! Schnelle Reflexe, gute Deckung und Teamarbeit entscheiden, wer das Feld am Ende dominiert.",
    icon: "lasertag",
  },
  {
    name: "TNT Tag",
    description:
      "Wer zuletzt die tickende TNT in der Hand hält, verliert! Gib sie rechtzeitig an einen anderen Spieler weiter, bevor sie hochgeht. Geschwindigkeit und Strategie entscheiden über Sieg oder Niederlage.",
    icon: "tnttag",
  },
];

// Tiny square PNG icons for games that don't have artwork yet.
const ICONS: Record<string, ImageMetadata> = {
  bedwars: IconBedWars,
  skywars: IconSkyWars,
  chess: IconChess,
  hideandseek: IconHideAndSeek,
  lasertag: IconLasertag,
  tnttag: IconTntTag,
};
---

<DefaultLayout>
  <div
    class="max-w-5xl mx-auto px-4 sm:px-8 py-16 sm:py-20 text-text font-sans space-y-20"
  >
    <img
      src={TextLogo}
      class="mx-auto h-30 md:h-80 object-cover"
      alt="Baggel Logo"
    />

    <!-- Server Info Section -->
    <section
      class="info-section bg-background-10 relative max-w-xl mx-auto text-left text-text rounded-4xl shadow-lg border border-background-50 hover:border-accent transition-all duration-500 overflow-hidden"
    >
      <div class="absolute inset-0 h-67 overflow-hidden">
        <img
          src={Screenshot}
          alt="Server Screenshot"
          class="blur-xs w-full scale-105 h-full object-cover object-center opacity-40 group-hover:opacity-50 transition-opacity duration-500"
        />
      </div>

      <!-- Content Overlay -->
      <div
        class="relative z-10 px-6 sm:px-8 md:px-10 py-10 text-center space-y-4 bg-transparent"
      >
        <h2
          class="text-xl sm:text-2xl font-bold tracking-wide text-primary text-center"
        >
          Server-Status
        </h2>

        <ul class="space-y-2 text-base">
          <li>
            <strong>Status:</strong>
            <span id="server-status" class="text-neutral-400">Lädt...</span>
          </li>
          <li>
            <strong>Spieler:</strong>
            <span id="server-players" class="text-neutral-400">0 / 0</span>
          </li>
        </ul>

        <div class="mt-4 text-center hidden md:block">
          <div
            class="motd-box mt-2 items-center gap-4 font-minecraft text-xs group inline-flex"
            style={`background-image: url('${DirtTexture.src}');`}
          >
            <div
              class="icon-container relative w-16 h-16 shrink-0 hidden select-none"
              id="serverIconContainer"
            >
              <img
                id="server-icon"
                alt="Server Icon"
                class="icon-image w-full h-full object-cover"
              />
              <img
                src={PlayButtonTexture.src}
                alt="Play Button Overlay"
                class="icon-overlay absolute inset-0 w-full h-full object-cover"
              />
              <img
                src={PlayButtonHoverTexture.src}
                alt="Play Button Hover Overlay"
                class="icon-overlay-hover absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100"
              />
              <audio id="clickAudio" src={Click}></audio>
            </div>

            <span id="server-motd" class="text-text-50">Lädt MOTD...</span>
          </div>
        </div>

        <div class="mt-4 flex justify-center">
          <CopyServerAddressButton
            text="Kopiere Server-Adresse"
            copyText={LINKS.server_address}
          />
        </div>
      </div>
    </section>

    <section
      class="definition-section max-w-xl mx-auto px-6 sm:px-8 md:px-10 text-left text-text rounded-4xl bg-linear-to-br from-background-10 to-background-10 border border-background-50 hover:border-accent transition-all duration-500 shadow-lg hover:shadow-2xl py-5"
    >
      <div class="flex items-center gap-4">
        <h2
          class="text-xl sm:text-2xl font-bold italic tracking-wide text-primary mb-4"
        >
          Ba·ggel
        </h2>
        <button
          id="playAudioButton"
          class="audio-button text-text-50 hover:text-primary transition-all duration-300"
          aria-label="Play pronunciation"
        >
          <svg
            id="speakerIcon"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 32 32"
            class="w-10 h-10 sm:w-15 sm:h-15"
          >
            <path
              xmlns="http://www.w3.org/2000/svg"
              d="M20.4,2.9c-0.3-0.2-0.7-0.1-1,0.1L9.7,10H3c-0.6,0-1,0.4-1,1v10c0,0.6,0.4,1,1,1h6.7l9.7,7.1c0.2,0.1,0.4,0.2,0.6,0.2   c0.2,0,0.3,0,0.5-0.1c0.3-0.2,0.5-0.5,0.5-0.9V3.8C21,3.4,20.8,3,20.4,2.9z"
            ></path>
            <path
              xmlns="http://www.w3.org/2000/svg"
              d="M27.1,9.3c-0.4-0.4-1-0.4-1.4,0s-0.4,1,0,1.4C27.2,12.1,28,14,28,16s-0.8,3.9-2.3,5.3c-0.4,0.4-0.4,1,0,1.4   c0.2,0.2,0.5,0.3,0.7,0.3c0.2,0,0.5-0.1,0.7-0.3C29,20.9,30,18.6,30,16S29,11.1,27.1,9.3z"
            ></path>
            <path
              xmlns="http://www.w3.org/2000/svg"
              d="M24.7,12.7c-0.4-0.4-1-0.4-1.4,0.1c-0.4,0.4-0.3,1,0.1,1.4c0.5,0.5,0.8,1.2,0.8,1.9s-0.3,1.4-0.8,1.9   c-0.4,0.4-0.4,1-0.1,1.4c0.2,0.2,0.5,0.3,0.7,0.3c0.2,0,0.5-0.1,0.7-0.3c1-0.9,1.5-2.1,1.5-3.3S25.6,13.5,24.7,12.7z"
            ></path>
          </svg>
        </button>
      </div>

      <p class="text-text-50 text-lg italic mb-2">nomen</p>
      <p class="text-text-100 text-base mb-4">/ˈbeɪɡl̩/</p>
      <p class="text-lg text-text-50">
        eine <span class="text-accent">Minecraft server community</span>
      </p>

      <audio id="pronunciationAudio" src={Pronounciation}></audio>
    </section>

    <!-- Finished Games Section -->
    <section class="finished-games text-center">
      <h2 class="text-2xl font-bold mb-8 text-primary">Verfügbare Spiele</h2>

      <div class="flex flex-wrap justify-center gap-8">
        {
          finishedGames.map((game) => (
            <div
              class="tilt-card game-card w-full sm:w-[45%] lg:w-[45%] max-w-xl relative rounded-2xl overflow-hidden bg-background-10 border border-background-50 transition-colors duration-500 shadow-lg"
              style={`--accent:#d6904f`}
            >
              <div class="cursor-glow" />
              <span class="corner corner-tl" />
              <span class="corner corner-br" />

              <div class="relative z-10 h-52 sm:h-56 overflow-hidden">
                <div class="progressive-img-wrapper w-full h-full">
                  <img
                    src={game.images[0]}
                    data-images={JSON.stringify(game.images)}
                    alt={game.image_alt}
                    loading="lazy"
                    decoding="async"
                    class="progressive-img w-full h-full object-cover"
                  />
                </div>
                <span
                  class="absolute top-4 right-4 z-2 font-minecraft text-[10px] tracking-normal px-2 py-1 rounded backdrop-blur-sm"
                  style={`background:color-mix(in srgb, #d6904f 18%, transparent); color:#d6904f; border:1px solid color-mix(in srgb, #d6904f 40%, transparent);`}
                >
                  Verfügbar
                </span>
              </div>

              <div class="relative z-10 p-6 text-left space-y-3">
                <h3 class="text-xl font-bold text-primary">{game.name}</h3>
                <div class="flex flex-wrap gap-2">
                  {game.tags.map((tag) => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
                <p class="text-text-50">{game.description}</p>
              </div>

              <div class="card-shine" />
            </div>
          ))
        }
      </div>
    </section>

    <Separator />

    <!-- Coming Soon Section -->
    <section class="unfinished-games text-center">
      <h2 class="text-2xl font-bold mb-8 text-primary">Demnächst</h2>

      <div class="flex flex-wrap justify-center gap-8">
        {
          unfinishedGames.map((game) => (
            <div
              class="tilt-card game-card game-card--concept w-full sm:w-[45%] lg:w-[45%] max-w-xl relative rounded-2xl overflow-hidden bg-background-10 border-2 border-dashed border-background-50 transition-colors duration-500"
              style={`--accent:#d6904f`}
            >
              <div class="cursor-glow" />

              <div class="blueprint-grid relative z-10 h-52 sm:h-56 overflow-hidden flex items-center justify-center">
                <pre class="code-typer" aria-hidden="true" />
                {/* @ts-ignore */}
                <img
                  src={ICONS[game.icon]}
                  alt={`${game.name} Icon`}
                  class="icon-visual w-16 h-16 object-contain [image-rendering:pixelated]"
                />
                <span
                  class="absolute top-4 right-4 z-2 font-minecraft text-[10px] tracking-normal px-2 py-1 rounded backdrop-blur-sm"
                  style={`background:color-mix(in srgb, #d6904f 18%, transparent); color:#d6904f; border:1px solid color-mix(in srgb, #d6904f 40%, transparent);`}
                >
                  In Entwicklung
                </span>
              </div>

              <div class="relative z-10 p-6 text-left space-y-3">
                <h3 class="text-xl font-bold text-primary">{game.name}</h3>
                <p class="text-text-50">{game.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Development Notice -->
    <section class="text-center max-w-2xl mx-auto">
      <Separator />
      <p class="text-text-50 text-base">
        Unser Server befindet sich derzeit in <span
          class="text-accent font-semibold">aktiver Entwicklung</span
        >.<br />
        Neue Spielmodi und Funktionen werden ständig hinzugefügt. Bleib dran!
      </p>
    </section>
  </div>
</DefaultLayout>

<script src="../scripts/index/pronounciationButton.ts"></script>

<script src="../scripts/index/serverStatus.ts"></script>

<script src="../scripts/index/progressiveImages.ts"></script>

<script src="../scripts/index/cardTilt.ts"></script>

<script src="../scripts/index/codeTyper.ts"></script>

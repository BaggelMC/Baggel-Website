---
import React from "react";
import Layout from "../../../layouts/DefaultLayout.astro";
import BedOverlayConverter from "src/components/BedOverlayConverter";
import Headline from "../../../components/Headline.astro";
---

<Layout title="Bed Overlay Tool" titleSuffix="Tool">
  <div class="max-w-5xl mx-auto px-8 py-20">
    <Headline text="Bed Overlay Converter" />
    <BedOverlayConverter client:load />

    <p class="text-sm ext-text-50 text-center mt-12 mb-2">
      Credits for Idea:
    </p>
    <ul class="text-md text-text-100 text-center space-y-1">
      <li>Basti4457</li>
      <li>Perry</li>
    </ul>
  </div>
</Layout>

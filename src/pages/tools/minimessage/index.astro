8269 18.2269 5.28136 17.8887 5.4588C17.3915 5.71959 16.7969 5.73002 16.3099 5.45096C15.8229 5.17191 15.5347 4.65566 15.5136 4.09794C15.4993 3.71848 15.4628 3.45833 15.3694 3.23463C15.1649 2.74458 14.7726 2.35523 14.2788 2.15224ZM12.5 15C14.1695 15 15.5228 13.6569 15.5228 12C15.5228 10.3431 14.1695 9 12.5 9C10.8305 9 9.47716 10.3431 9.47716 12C9.47716 13.6569 10.8305 15 12.5 15Z"
            ></path>
          </svg>
          Settings
        </span>
        <svg
          id="settings-chevron"
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4 transition-transform duration-200"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <div id="settings-body" class="hidden border-t border-background-50">
        <div class="px-4 py-4 flex flex-wrap gap-6 items-center">
          <div class="flex items-center gap-3">
            <span class="text-sm text-text-80">Strict Mode</span>
            <button
              id="strict-toggle"
              role="switch"
              aria-checked="false"
              class="relative inline-flex h-6 w-11 items-center rounded-full bg-background-50 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
              title="When enabled, malformed tags throw errors instead of being passed through as plain text"
            >
              <span
                id="strict-knob"
                class="inline-block h-4 w-4 translate-x-1 rounded-full bg-text-50 shadow transition-all duration-200"
              ></span>
            </button>
            <span id="strict-label" class="text-xs text-text-50 w-16">Off</span>
          </div>

          <div class="flex items-center gap-3">
            <label for="lang-select" class="text-sm text-text-80 shrink-0"
              >Language</label
            >
            <div class="relative">
              <select
                id="lang-select"
                size="1"
                class="appearance-none bg-background-50 text-text text-sm rounded-lg pl-3 pr-8 py-1.5 border border-transparent hover:border-primary focus:outline-none focus:border-primary transition-colors duration-200 cursor-pointer"
              ></select>
              <svg
                class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-50"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col io relative">
      <label
        id="output-dom-label"
        class="text-text-50 mb-2 text-sm uppercase tracking-wide">Output</label
      >

      <button
        id="copy-json-btn"
        class="absolute top right-0 bg-background-50 hover:bg-background-100 text-text text-xs px-2 py-1 rounded-lg cursor-pointer hover:scale-105"
        title="Copy as JSON (for tellraw, etc.)"
      >
        <span class="btn-text">Copy JSON</span>
      </button>

      <div class="relative">
        <div
          id="output-dom"
          class="content w-full min-h-[200px] p-4 bg-background-gradient text-[#FFFFFF] font-minecraft-minimessage rounded-2xl border border-background-50 wrap-break-word whitespace-pre-wrap"
        >
        </div>
      </div>
      <div
        id="mc-tooltip"
        class="font-minecraft-minimessage"
        aria-hidden="true"
      >
      </div>
    </div>
    <section
      class="bg-background rounded-xl max-w-5xl mx-auto px-8 p-8 text-text font-sans space-y-10"
    >
      <div class="space-y-4">
        <h2 class="text-xl font-semibold">What is MiniMessage?</h2>

        <p class="text-text-80 leading-relaxed">
          <strong>MiniMessage</strong> is a modern text formatting language from the
          <a
            href="https://docs.papermc.io/adventure/minimessage/format"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:opacity-80"
          >
            Adventure
          </a>
          library, widely used in Minecraft servers and plugins such as Paper, Velocity,
          Fabric, and more.
        </p>

        <p class="text-text-80 leading-relaxed">
          It allows you to format text using readable tags instead of legacy
          color codes, supporting colors, gradients, text decorations, shadows,
          fonts, and other advanced effects in a clean and future-proof way.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-semibold">Why use this editor?</h2>

        <p class="text-text-80 leading-relaxed">
          This MiniMessage Editor lets you write, preview, and export
          MiniMessage text instantly directly in your browser.
        </p>

        <p class="text-text-80 leading-relaxed">
          This tool runs
          <strong>100% client-side</strong>. No data is sent to any server, and
          nothing ever leaves your device.
        </p>

        <p class="text-text-80 leading-relaxed">
          The renderer is based on an extended and customized version of the
          original minimessage-js renderer by <strong>WasabiThumb</strong>:
        </p>

        <ul class="list-disc list-inside text-text-80 space-y-1">
          <li>
            <a
              href="https://github.com/WasabiThumb/minimessage-js"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary underline hover:opacity-80"
            >
              Original
            </a>
          </li>
          <li>
            <a
              href="https://github.com/BaggelMC/minimessage-js"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary underline hover:opacity-80"
            >
              Our fork
            </a>
          </li>
        </ul>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-semibold">Not using MiniMessage?</h2>

        <p class="text-text-80 leading-relaxed">
          You can still use this tool as a <strong
            >Minecraft text formatter</strong
          >.
        </p>

        <p class="text-text-80 leading-relaxed">
          The <strong>Copy JSON</strong> button copies the rendered output as a Minecraft
          Component JSON. This can be used in commands and configurations such as
          <code class="px-1 py-0.5 bg-background-50 rounded">/tellraw</code>,
          titles, bossbars, datapacks, and plugin configs that accept component
          JSON.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-semibold">Planned features</h2>

        <p class="text-text-80 leading-relaxed">
          The following MiniMessage features are planned but not implemented
          yet:
        </p>

        <ul class="list-disc list-inside text-text-80 space-y-1">
          <li>Click</li>
          <li>Hover</li>
          <li>Fallback</li>
          <li>Insertion</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-semibold">Server-only features</h2>

        <p class="text-text-80 leading-relaxed">
          Some MiniMessage features depend on live server data and cannot be
          supported in an external editor:
        </p>

        <ul class="list-disc list-inside text-text-80 space-y-1">
          <li>Selector</li>
          <li>Score</li>
          <li>NBT</li>
        </ul>
      </div>
    </section>
  </div>

  <script>
    const textarea = document.getElementById(
      "input",
    ) as HTMLTextAreaElement | null;
    const resizer = document.getElementById("resizer") as HTMLDivElement | null;

    if (textarea && resizer) {
      let startY: number;
      let startHeight: number;

      resizer.addEventListener("mousedown", (e: MouseEvent) => {
        e.preventDefault();
        startY = e.clientY;
        startHeight = textarea.offsetHeight;

        const onMouseMove = (e: MouseEvent) => {
          const newHeight = startHeight + (e.clientY - startY);
          if (newHeight >= 100) {
            textarea.style.height = `${newHeight}px`;

            const simplebarEl = textarea.closest(
              "[data-simplebar]",
            ) as HTMLElement | null;
            const simplebarInstance =
              simplebarEl && (simplebarEl as any).SimpleBar;
            simplebarInstance?.recalculate();
          }
        };

        const onMouseUp = () => {
          window.removeEventListener("mousemove", onMouseMove);
          window.removeEventListener("mouseup", onMouseUp);
        };

        window.addEventListener("mousemove", onMouseMove);
        window.addEventListener("mouseup", onMouseUp);
      });
    }
  </script>

  <script>
    import { renderToolbar } from "@scripts/minimessage/toolbar";
    import { boldTag } from "@scripts/minimessage/definitions/bold";
    import { italicTag } from "@scripts/minimessage/definitions/italic";
    import { underlinedTag } from "@scripts/minimessage/definitions/underlined";
    import { strikethroughTag } from "@scripts/minimessage/definitions/strikethrough";
    import { obfuscatedTag } from "@scripts/minimessage/definitions/obfuscated";
    import { headTag } from "@scripts/minimessage/definitions/head";
    import { colorTag } from "@scripts/minimessage/definitions/color";
    import { gradientTag } from "@scripts/minimessage/definitions/gradient";
    import { shadowColorTag } from "@scripts/minimessage/definitions/shadow";

    const textarea = document.getElementById("input");
    const toolbar = document.getElementById("tag-toolbar");

    if (
      textarea instanceof HTMLTextAreaElement &&
      toolbar instanceof HTMLDivElement
    ) {
      renderToolbar(toolbar, textarea, [
        colorTag,
        boldTag,
        italicTag,
        underlinedTag,
        strikethroughTag,
        obfuscatedTag,
        shadowColorTag,
        gradientTag,
        headTag,
      ]);
    }
  </script>

  <script>
    const textarea = document.getElementById(
      "input",
    ) as HTMLTextAreaElement | null;

    if (textarea) {
      const updateColor = () => {
        if (textarea.value.trim() === "") {
          textarea.classList.add("placeholder-color");
          textarea.classList.remove("input-color");
        } else {
          textarea.classList.add("input-color");
          textarea.classList.remove("placeholder-color");
        }
      };

      updateColor();

      textarea.addEventListener("input", updateColor);
    }
  </script>
</Layout>
<script lang="js">
  ((window) => {
    const { MiniMessage } = window.adventure;

    window.addEventListener("DOMContentLoaded", async () => {
      const input = document.querySelector("#input");
      const domOutput = document.querySelector("#output-dom");
      const copyBtn = document.querySelector("#copy-json-btn");
      const strictToggle = document.querySelector("#strict-toggle");
      const strictKnob = document.querySelector("#strict-knob");
      const strictLabel = document.querySelector("#strict-label");
      const langSelect = document.querySelector("#lang-select");

      if (!input || !domOutput || !copyBtn) return;

      const translationsModule =
        await import("/tools/minimessage/translation/index.mjs");
      const MinecraftTranslations = translationsModule.default;

      let strictMode = false;
      let currentLang = "en_us";

      async function buildMini() {
        const raw = await MinecraftTranslations.get(currentLang);
        return MiniMessage.builder()
          .strict(strictMode)
          .translations(raw)
          .build();
      }

      let mini = await buildMini();

      function update() {
        domOutput.innerHTML = "";
        try {
          const component = mini.deserialize(input.value);
          mini.toHTML(component, domOutput);
          copyBtn.dataset.json = JSON.stringify(component, null, 2);
        } catch (e) {
          console.trace(e);
          copyBtn.dataset.json = "";
          domOutput.innerHTML = `<span style="color:#ff5555;font-family:monospace;font-size:0.85em;opacity:0.8">${e.message ?? "Parse error"}</span>`;
        }
      }

      input.addEventListener("input", update);
      update();

      if (strictToggle && strictKnob && strictLabel) {
        strictToggle.addEventListener("click", async () => {
          strictMode = !strictMode;
          strictToggle.setAttribute("aria-checked", String(strictMode));
          if (strictMode) {
            strictKnob.style.transform = "translateX(1.375rem)";
            strictKnob.style.background = "var(--color-primary)";
            strictToggle.style.background =
              "color-mix(in srgb, var(--color-primary) 30%, transparent)";
            strictLabel.textContent = "On";
          } else {
            strictKnob.style.transform = "translateX(0.25rem)";
            strictKnob.style.background = "";
            strictToggle.style.background = "";
            strictLabel.textContent = "Off";
          }
          mini = await buildMini();
          update();
        });
      }

      if (langSelect) {
        langSelect.addEventListener("change", async () => {
          currentLang = langSelect.value;
          mini = await buildMini();
          update();
        });
      }

      copyBtn.addEventListener("click", () => {
        const json = copyBtn.dataset.json;
        if (!json) return;

        navigator.clipboard
          .writeText(json)
          .then(() => {
            const textSpan = copyBtn.querySelector(".btn-text");
            if (textSpan) {
              textSpan.textContent = "Copied!";
              setTimeout(() => {
                textSpan.textContent = "Copy JSON";
              }, 1500);
            }
          })
          .catch((err) => console.error("Failed to copy JSON:", err));
      });
    });
  })(window);
</script>

<script>

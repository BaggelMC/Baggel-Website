---
import Headline from "../../../components/Headline.astro";
import Layout from "../../../layouts/DefaultLayout.astro";

import "../../../styles/MiniMessageTool.css";
---

<Layout title="MiniMessage" titleSuffix="Tool">
  <Fragment slot="head">
    <script src="/tools/minimessage/minimessage.umd.js" is:inline></script>

    <noscript>
      <style>
        .simplebar-content-wrapper {
          scrollbar-width: auto;
          -ms-overflow-style: auto;
        }
        .simplebar-content-wrapper::-webkit-scrollbar {
          display: initial;
        }
      </style>
    </noscript>
  </Fragment>
  <style>
    #mc-tooltip {
      display: none;
      position: fixed;
      z-index: 9999;
      pointer-events: none;

      color: #fbfbfb;
      text-shadow: 0.125em 0.125em 0 #3e3e3e;
      background-color: rgba(16, 0, 16, 0.94);
      padding: 0.375em;
      font-family: MinecraftMiniMessage, sans-serif;
      font-size: 16px;
      word-spacing: 4px;
      white-space: nowrap;
      line-height: 1.25em;
      margin: 0.125em 0.25em;
    }

    #mc-tooltip::after {
      content: "";
      position: absolute;
      top: 0.125em;
      right: 0;
      bottom: 0.125em;
      left: 0;
      border: 0.125em solid #2d0a63;
      border-image: linear-gradient(
          rgba(80, 0, 255, 0.31),
          rgba(40, 0, 127, 0.31)
        )
        1;
    }

    #mc-tooltip::before {
      content: "";
      position: absolute;
      top: 0.125em;
      right: -0.125em;
      bottom: 0.125em;
      left: -0.125em;
      border: 0.15em solid rgba(16, 0, 16, 0.94);
      border-style: none solid;
    }
  </style>
  <div class="max-w-5xl mx-auto px-8 py-20 text-text font-sans space-y-12">
    <Headline text="MiniMessage Editor" class="text-center" />

    <div class="flex flex-col relative">
      <label
        id="input-label"
        class="text-text-50 mb-2 text-sm uppercase tracking-wide">Input</label
      >

      <div id="tag-toolbar" class="flex flex-wrap gap-2 mb-3"></div>

      <div
        data-simplebar
        data-simplebar-auto-hide="false"
        class="w-full min-h-[200px] rounded-2xl bg-background-10 focus-within:ring-2 focus-within:ring-primary transition duration-300"
        style="overflow: hidden;"
      >
        <textarea
          id="input"
          spellcheck="false"
          class="min-h-[200px] w-full h-full p-4 bg-transparent font-sans focus:outline-none transition duration-300 resize-none"
          placeholder="Type MiniMessage text here..."></textarea>

        <div
          id="resizer"
          class="absolute bottom-3.5 right-2.5 w-4 h-4 cursor-n-resize"
          title="Resize"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="var(--color-primary)"
            viewBox="0 0 384.792 384.792"
            class="w-full h-full"
          >
            <path
              d="M116.783,281.339c-4.74-4.704-12.439-4.704-17.179,0c-4.74,4.704-4.74,12.319,0,17.011
              l84.2,82.997c4.644,4.559,12.512,4.632,17.191-0.012l84.188-82.997c4.74-4.704,4.74-12.319,0-17.011
              c-4.752-4.692-12.439-4.704-17.191,0l-63.448,62.558V40.89l63.46,62.558c4.752,4.704,12.439,4.692,17.179,0
              c4.752-4.704,4.752-12.319,0-17.011l-84.2-82.997c-4.812-4.776-12.367-4.391-17.191,0L99.604,86.436
              c-4.752,4.704-4.74,12.319,0,17.011c4.74,4.704,12.439,4.704,17.179,0l63.46-62.558v303.007L116.783,281.339z"
            ></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Settings Panel -->
    <div
      id="settings-panel"
      class="rounded-2xl bg-background-10 border border-background-50 overflow-hidden"
    >
      <button
        id="settings-toggle"
        class="w-full flex items-center justify-between px-4 py-3 text-text-50 hover:text-text transition-colors duration-200 cursor-pointer"
        aria-expanded="false"
        aria-controls="settings-body"
      >
        <span
          class="flex items-center gap-2 text-sm uppercase tracking-wide font-medium"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            stroke="none"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"

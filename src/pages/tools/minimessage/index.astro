---
import Headline from "../../../components/Headline.astro";
import Layout from "../../../layouts/DefaultLayout.astro";

import "../../../styles/MiniMessageTool.css";
---

<Layout title="MiniMessage" titleSuffix="Tool">
  <Fragment slot="head">
    <script src="/tools/minimessage/minimessage.umd.js" is:inline></script>

    <noscript>
      <style>
        .simplebar-content-wrapper {
          scrollbar-width: auto;
          -ms-overflow-style: auto;
        }
        .simplebar-content-wrapper::-webkit-scrollbar {
          display: initial;
        }
      </style>
    </noscript>
  </Fragment>
  <div
    class="max-w-6xl mx-auto px-6 sm:px-8 py-16 sm:py-20 text-text font-sans space-y-8"
  >
    <div class="text-center space-y-3">
      <Headline text="MiniMessage Editor" class="text-center" />
      <p class="text-text-50 text-sm max-w-xl mx-auto">
        Write, preview, and export MiniMessage-formatted text — live, right in
        your browser.
      </p>
    </div>

    <!-- Settings Panel -->
    <div
      id="settings-panel"
      class="rounded-2xl bg-background-10 border border-background-50 overflow-hidden shadow-sm"
    >
      <button
        id="settings-toggle"
        class="w-full flex items-center justify-between px-4 py-3 text-text-50 hover:text-text transition-colors duration-200 cursor-pointer"
        aria-expanded="false"
        aria-controls="settings-body"
      >
        <span
          class="flex items-center gap-2 text-sm uppercase tracking-wide font-medium"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            stroke="none"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M14.2788 2.15224C13.9085 2 13.439 2 12.5 2C11.561 2 11.0915 2 10.7212 2.15224C10.2274 2.35523 9.83509 2.74458 9.63056 3.23463C9.53719 3.45834 9.50065 3.7185 9.48635 4.09799C9.46534 4.65568 9.17716 5.17189 8.69017 5.45093C8.20318 5.72996 7.60864 5.71954 7.11149 5.45876C6.77318 5.2813 6.52789 5.18262 6.28599 5.15102C5.75609 5.08178 5.22018 5.22429 4.79616 5.5472C4.47814 5.78938 4.24339 6.1929 3.7739 6.99993C3.30441 7.80697 3.06967 8.21048 3.01735 8.60491C2.94758 9.1308 3.09118 9.66266 3.41655 10.0835C3.56506 10.2756 3.77377 10.437 4.0977 10.639C4.57391 10.936 4.88032 11.4419 4.88029 12C4.88026 12.5581 4.57386 13.0639 4.0977 13.3608C3.77372 13.5629 3.56497 13.7244 3.41645 13.9165C3.09108 14.3373 2.94749 14.8691 3.01725 15.395C3.06957 15.7894 3.30432 16.193 3.7738 17C4.24329 17.807 4.47804 18.2106 4.79606 18.4527C5.22008 18.7756 5.75599 18.9181 6.28589 18.8489C6.52778 18.8173 6.77305 18.7186 7.11133 18.5412C7.60852 18.2804 8.2031 18.27 8.69012 18.549C9.17714 18.8281 9.46533 19.3443 9.48635 19.9021C9.50065 20.2815 9.53719 20.5417 9.63056 20.7654C9.83509 21.2554 10.2274 21.6448 10.7212 21.8478C11.0915 22 11.561 22 12.5 22C13.439 22 13.9085 22 14.2788 21.8478C14.7726 21.6448 15.1649 21.2554 15.3694 20.7654C15.4628 20.5417 15.4994 20.2815 15.5137 19.902C15.5347 19.3443 15.8228 18.8281 16.3098 18.549C16.7968 18.2699 17.3914 18.2804 17.8886 18.5412C18.2269 18.7186 18.4721 18.8172 18.714 18.8488C19.2439 18.9181 19.7798 18.7756 20.2038 18.4527C20.5219 18.2105 20.7566 17.807 21.2261 16.9999C21.6956 16.1929 21.9303 15.7894 21.9827 15.395C22.0524 14.8691 21.9088 14.3372 21.5835 13.9164C21.4349 13.7243 21.2262 13.5628 20.9022 13.3608C20.4261 13.0639 20.1197 12.558 20.1197 11.9999C20.1197 11.4418 20.4261 10.9361 20.9022 10.6392C21.2263 10.4371 21.435 10.2757 21.5836 10.0835C21.9089 9.66273 22.0525 9.13087 21.9828 8.60497C21.9304 8.21055 21.6957 7.80703 21.2262 7C20.7567 6.19297 20.522 5.78945 20.2039 5.54727C19.7799 5.22436 19.244 5.08185 18.7141 5.15109C18.4722 5.18269 18.2269 5.28136 17.8887 5.4588C17.3915 5.71959 16.7969 5.73002 16.3099 5.45096C15.8229 5.17191 15.5347 4.65566 15.5136 4.09794C15.4993 3.71848 15.4628 3.45833 15.3694 3.23463C15.1649 2.74458 14.7726 2.35523 14.2788 2.15224ZM12.5 15C14.1695 15 15.5228 13.6569 15.5228 12C15.5228 10.3431 14.1695 9 12.5 9C10.8305 9 9.47716 10.3431 9.47716 12C9.47716 13.6569 10.8305 15 12.5 15Z"
            ></path>
          </svg>
          Settings
        </span>
        <svg
          id="settings-chevron"
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4 transition-transform duration-200"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <div id="settings-body" class="hidden border-t border-background-50">
        <div class="px-4 py-4 flex flex-wrap gap-6 items-center">
          <div class="flex items-center gap-3">
            <span class="text-sm text-text-80">Strict Mode</span>
            <button
              id="strict-toggle"
              role="switch"
              aria-checked="false"
              class="relative inline-flex h-6 w-11 items-center rounded-full bg-background-50 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
              title="When enabled, using the <reset> tag is prohibited and all tags must be closed in reverse order of opening."
            >
              <span
                id="strict-knob"
                class="inline-block h-4 w-4 translate-x-1 rounded-full bg-text-50 shadow transition-all duration-200"
              ></span>
            </button>
            <span id="strict-label" class="text-xs text-text-50 w-16">Off</span>
          </div>

          <div class="flex items-center gap-3">
            <label for="lang-select" class="text-sm text-text-80 shrink-0">
              <span class="sm:hidden">Lang</span>
              <span class="hidden sm:inline">Language</span>
            </label>
            <div class="relative">
              <select
                id="lang-select"
                size="1"
                class="appearance-none bg-background-50 text-text text-sm rounded-lg pl-3 pr-8 py-1.5 border border-transparent hover:border-primary focus:outline-none focus:border-primary transition-colors duration-200 cursor-pointer"
              ></select>
              <svg
                class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-50"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <label
              for="resourcepack-input"
              class="text-sm text-text-80 shrink-0 cursor-pointer bg-background-50 hover:bg-background-100 rounded-lg px-3 py-1.5 transition-colors duration-200"
            >
              Upload Resource Pack
            </label>
            <input
              type="file"
              id="resourcepack-input"
              accept=".zip"
              multiple
              class="hidden"
            />
          </div>

          <div
            id="resourcepack-list"
            class="hidden px-4 pb-4 flex flex-col gap-2 border-t border-background-50 pt-3"
          >
          </div>
        </div>
      </div>
    </div>

    <div
      id="tag-toolbar"
      class="flex flex-wrap items-center gap-x-1 gap-y-2 rounded-2xl bg-background-10 border border-background-50 px-3 py-2.5 shadow-sm"
    >
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <div class="flex flex-col relative">
        <label
          id="input-label"
          class="text-text-50 mb-2 text-sm uppercase tracking-wide">Input</label
        >

        <div
          data-simplebar
          data-simplebar-auto-hide="false"
          class="w-full min-h-50 rounded-2xl bg-background-10 focus-within:ring-2 focus-within:ring-primary transition duration-300"
          style="overflow: hidden;"
        >
          <div
            id="input"
            contenteditable="true"
            spellcheck="false"
            class="px-4 py-4 min-h-50"
            style="white-space: pre-wrap; word-break: break-word;"
            data-placeholder="Type MiniMessage text here..."
          >
          </div>
        </div>
      </div>

      <div class="flex flex-col io relative">
        <div class="flex items-center justify-between mb-2">
          <label
            id="output-dom-label"
            class="text-text-50 text-sm uppercase tracking-wide">Output</label
          >

          <button
            id="copy-json-btn"
            class="bg-background-50 hover:bg-background-100 text-text text-xs px-2 py-1 rounded-lg cursor-pointer transition-colors duration-200"
            title="Copy as JSON (for tellraw, etc.)"
          >
            <span class="btn-text">Copy JSON</span>
          </button>
        </div>

        <div class="relative">
          <div
            id="output-dom"
            class="content w-full min-h-50 p-4 bg-background-gradient text-[#FFFFFF] font-minecraft-minimessage rounded-2xl border border-background-50 wrap-break-word whitespace-pre-wrap"
          >
          </div>
        </div>
        <div
          id="mc-tooltip"
          class="font-minecraft-minimessage"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>

    <div
      class="pt-6 border-t border-background-50 flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-xs text-text-50 text-center"
    >
      <span
        >Runs 100% client-side — nothing you type ever leaves your browser.</span
      >
      <span class="hidden sm:inline text-background-100">&bull;</span>
      <a
        href="https://docs.papermc.io/adventure/minimessage/format"
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary hover:opacity-80 transition-opacity duration-200"
      >
        MiniMessage documentation ↗
      </a>
      <span class="hidden sm:inline text-background-100">&bull;</span>
      <span>
        Renderer based on a fork of
        <a
          href="https://github.com/WasabiThumb/minimessage-js"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:opacity-80 transition-opacity duration-200"
          >minimessage-js</a
        >
        by WasabiThumb —
        <a
          href="https://github.com/BaggelMC/minimessage-js"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:opacity-80 transition-opacity duration-200"
          >view our fork ↗</a
        >
      </span>
    </div>
  </div>

  <script>
    import { initResizer } from "@scripts/minimessage/resizer";
    import { initPlaceholderColor } from "@scripts/minimessage/placeholder-color";
    import { initToolbar } from "@scripts/minimessage/toolbar-init";
    import { initApp } from "@scripts/minimessage/app";
    import { initSettingsPanel } from "@scripts/minimessage/settings-panel";
    import { initClickPopups } from "@scripts/minimessage/click-popups";
    import { initTooltip } from "@scripts/minimessage/tooltip";

    initResizer();
    initPlaceholderColor();
    initToolbar();
    initApp();
    initSettingsPanel();
    initClickPopups();
    initTooltip();
  </script>
  <script src="../../../scripts/minimessage/debug.ts"></script>
  <div
    id="mc-click-container"
    aria-live="polite"
    aria-label="Click event notifications"
  >
  </div>
</Layout>

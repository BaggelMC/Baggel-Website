---
import { LINKS } from "../config";
import Headline from "../components/Headline.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
---

<DefaultLayout title="Impressum" enableBackground={false}>
  <div class="max-w-6xl mx-auto px-8 py-20 text-text font-sans">
    <Headline text="Impressum" />

    <section class="text-sm leading-base text-text-50">
      <p class="mb-6">Angaben gemäß § 5 DDG:</p>

      <div class="mb-8">
        <p class="font-bold mb-1">Louis Liposcak</p>
        <p class="mb-1">Betreiber von Baggel</p>
        <p class="mb-1">c/o IP-Management #11230</p>
        <p>Ludwig-Erhard-Str. 18</p>
        <p>20459 Hamburg</p>
        <p>Deutschland</p>
      </div>

      <div class="mb-8">
        <p class="font-semibold mb-1">
          Verantwortlich für den Inhalt
        </p>
        <p>Louis Liposcak</p>
      </div>

      <div class="mb-8">
        <p class="font-semibold mb-1">Kontakt</p>
        <p class="mb-1">Telefon: +49 40 696328495</p>
        <p class="mb-1">Dies ist die telefonische Erreichbarkeit meines Managements, worüber Sie mich zu den Öffnungszeiten Mo - Fr (09 - 17 Uhr) erreichen können.</p>
        <p>
          E-Mail:
          <a
            href={"mailto:" + LINKS.email}
            class="text-primary hover:underline"
          >
            {LINKS.email}
          </a>
        </p>
      </div>

      <div class="mb-8">
        <p class="mb-2">
          Dieses Impressum gilt für folgende Online-Angebote von Baggel:
        </p>

        <ul class="list-disc ml-6 space-y-1">
          <li>
            Website:
            <a href="https://baggel.de" class="text-primary hover:underline">
              https://baggel.de
            </a>
          </li>
          <li>Discord-Bot</li>
          <li>Minecraft-Server</li>
          <li>Offizielle Social-Media-Kanäle von Baggel</li>
        </ul>
      </div>

    </section>
  </div>
</DefaultLayout>
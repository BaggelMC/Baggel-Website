---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Separator from "src/components/Separator.astro";

import { getTeamMembers } from "../scripts/team";
import Headline from "../components/Headline.astro";

//@ts-ignore
import AururmLogo from "../assets/images/aurum_logo.png?format=webp";

const teamMembers = await getTeamMembers();
---

<DefaultLayout title="Team">
  <section class="py-20 max-w-6xl mx-auto px-4">
    <Headline text="Das Baggel Team:"></Headline>
    
    <div class="flex flex-wrap justify-center gap-8">
      {teamMembers.map((member, i) => (
        <div class="w-64 relative group">
          <button 
            class="w-full bg-background-10 rounded-xl overflow-hidden shadow-lg transform transition-smooth hover:scale-105 hover:shadow-2xl"
            onclick={`toggleInfo(${i})`}
          >

            <img src={member.image} alt={member.name} class="w-full h-48 object-cover" />
            <div class="p-3 text-center">
              <h2 class="text-primary text-lg font-semibold">{member.name}</h2>
              {member.role && <p class="text-text-50 text-sm mt-1">{member.role}</p>}
            </div>
          </button>

          <div 
          id={`info-${i}`} 
          class="hidden absolute left-1/2 -translate-x-1/2 z-10 mt-2 w-80 bg-background-50 p-3 rounded-lg shadow text-text overflow-hidden"
        >
          <div set:html={member.bio ?? ""}></div>
        </div>

        </div>
      ))}
    </div>

    <Separator></Separator>
    <h2 class="text-xl text-center leading-xl text-primary mt-12 mb-6 font-minecraft">Freunde & Partner</h2>
    <div class="flex flex-wrap justify-center gap-8">
      <div class="w-64 relative group">
        <a href="https://aurum-mc.de" target="_blank" class="group flex flex-col items-center bg-background-10 rounded-xl p-4 shadow-lg not-last-of-type:transform transition-smooth hover:scale-105 hover:shadow-2xl">
        <img src={AururmLogo} alt="Aurum Logo" class="w-32 h-32 object-contain mb-3" />
        <p class="text-center text-text-50 text-sm">
          Wir freuen uns über die freundschaftliche Zusammenarbeit mit <strong>Aurum MC</strong>! Schaut unbedingt auf ihrer Website vorbei.
        </p>
      </a>
      </div>
      
    </div>

  </section>


  <script is:inline>
    let openIndex = null;
    function toggleInfo(index) {
      const infoBox = document.getElementById(`info-${index}`);
      if (!infoBox) return;

      if (openIndex !== null && openIndex !== index) {
        const prevBox = document.getElementById(`info-${openIndex}`);
        if (prevBox) prevBox.classList.add("hidden");
      }

      if (infoBox.classList.contains("hidden")) {
        infoBox.classList.remove("hidden");
        openIndex = index;
      } else {
        infoBox.classList.add("hidden");
        openIndex = null;
      }
    }
  </script>
</DefaultLayout>

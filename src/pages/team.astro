---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Separator from "src/components/Separator.astro";
import Headline from "../components/Headline.astro";
import TeamGraph from "../components/TeamGraph";

//@ts-ignore
import AururmLogo from "../assets/images/aurum_logo.png?format=webp";
//@ts-ignore
import OrgLogo from "../assets/logo.png?format=webp";

import teamData from "../data/team.json";
---

<DefaultLayout title="Team">
  <section class="py-20 max-w-6xl mx-auto px-4">
    <Headline text="Das Baggel Team:" />
  </section>

  <div class="flex flex-wrap justify-center gap-8">
    <div class="w-full px-4 md:px-32" style="height: 700px;" oncontextmenu="event.preventDefault()">
      <TeamGraph client:load data={teamData} logoSrc={OrgLogo} />
    </div>
  </div>

  <section class="py-20 max-w-6xl mx-auto px-4">
    <Separator />
    <h2
      class="text-xl text-center leading-xl text-primary mt-12 mb-6 font-minecraft"
    >
      Freunde & Partner
    </h2>
    <div class="flex flex-wrap justify-center gap-8">
      <div class="w-64 relative group">
        <a
          href="https://aurum-mc.de"
          target="_blank"
          class="group flex flex-col items-center bg-background-10 rounded-xl p-4 shadow-lg transition-smooth hover:scale-105 hover:shadow-2xl"
        >
          <img
            src={AururmLogo}
            alt="Aurum Logo"
            class="w-32 h-32 object-contain mb-3"
          />
          <p class="text-center text-text-50 text-sm">
            Wir freuen uns über die freundschaftliche Zusammenarbeit mit{" "}
            <strong>Aurum MC</strong>! Schaut unbedingt auf ihrer Website
            vorbei.
          </p>
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>

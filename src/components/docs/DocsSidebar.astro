---
import type { NavNode } from "../../scripts/docs";
import type { Version } from "../../scripts/docs-config";

interface Props {
  nav: NavNode[];
  currentSlug: string;
  lang: string;
  version: Version;
  depth?: number;
}

const { nav, currentSlug, lang, version, depth = 0 } = Astro.props;
---

<ul class:list={["nav-list", { "nav-list--root": depth === 0, "nav-list--nested": depth > 0 }]} role="list">
  {nav.map((node) => {
    const isActive = node.item?.slug === currentSlug;
    const hasChildren = node.children.length > 0;

    return (
      <li>
        {node.item ? (
          <a
            href={node.item.href}
            class:list={[
              "nav-link",
              { "nav-link--active": isActive, "nav-link--deprecated": node.item.deprecated }
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            <span class="nav-link-label">{node.label}</span>
            {node.item.deprecated && <span class="deprecated-badge">deprecated</span>}
          </a>
        ) : (
          <span class="nav-section-header">{node.label}</span>
        )}

        {hasChildren && (
          <Astro.self
            nav={node.children}
            currentSlug={currentSlug}
            lang={lang}
            version={version}
            depth={depth + 1}
          />
        )}
      </li>
    );
  })}
</ul>

<style>
  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-px);
  }

  .nav-list--nested {
    margin-top: var(--space-px);
    margin-left: var(--space-4);
    padding-left: var(--space-3);
    border-left: 1px solid color-mix(in srgb, var(--color-separator) 25%, transparent);
  }

  .nav-section-header {
    display: block;
    padding: var(--space-3) var(--space-3) var(--space-1);
    font-size: 10px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-100);
    user-select: none;
  }

  /* Only add top margin on root-level section headers that aren't first */
  .nav-list--root > li + li > .nav-section-header {
    margin-top: var(--space-3);
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-radius: 5px;
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    color: var(--color-text-50);
    text-decoration: none;
    font-family: var(--font-sans);
    transition:
      color var(--transition-duration-fast) var(--transition-timing-default),
      background var(--transition-duration-fast) var(--transition-timing-default);
  }

  .nav-link:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-background-10) 60%, transparent);
  }

  .nav-link--active {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .nav-link--active:hover {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .nav-link--deprecated {
    color: color-mix(in srgb, var(--color-text-50) 60%, transparent);
  }

  .deprecated-badge {
    font-size: 9px;
    padding: 1px 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    font-family: var(--font-sans);
    flex-shrink: 0;
  }
</style>
---
import { LANGUAGES, type Version } from "../../scripts/docs-config";

interface Props {
  lang: string;
  version: Version;
  slug: string;
}

const { lang, version, slug } = Astro.props;
---

<div class="lang-switcher" x-data="{ open: false }" @click.outside="open = false">
  <button
    class="lang-trigger"
    @click="open = !open"
    :aria-expanded="open"
    aria-haspopup="listbox"
  >
    <span class="lang-label">Lang</span>
    <span class="lang-value">{LANGUAGES[lang] ?? lang}</span>
    <svg class="lang-chevron" :class="{ 'rotated': open }" width="12" height="12" viewBox="0 0 12 12" fill="none">
      <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <ul
    class="lang-dropdown"
    x-show="open"
    x-transition:enter="dropdown-enter"
    x-transition:enter-start="dropdown-enter-start"
    x-transition:enter-end="dropdown-enter-end"
    x-transition:leave="dropdown-leave"
    x-transition:leave-start="dropdown-enter-end"
    x-transition:leave-end="dropdown-enter-start"
    role="listbox"
  >
    {Object.entries(LANGUAGES).map(([code, label]) => (
      <li role="option" aria-selected={code === lang}>
        <a
          href={`/docs/${code}/${version}/${slug}`}
          class:list={["lang-option", { "lang-option--active": code === lang }]}
        >
          {label}
          {code === lang && (
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
              <path d="M1.5 5L3.5 7.5L8.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-switcher {
    position: relative;
    font-family: var(--font-sans);
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    background: var(--color-background-10);
    border: 1px solid color-mix(in srgb, var(--color-separator) 30%, transparent);
    border-radius: 6px;
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    transition:
      border-color var(--transition-duration-fast) var(--transition-timing-default),
      background var(--transition-duration-fast) var(--transition-timing-default);
  }

  .lang-trigger:hover {
    border-color: color-mix(in srgb, var(--color-separator) 60%, transparent);
    background: var(--color-background-50);
  }

  .lang-label {
    color: var(--color-text-50);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lang-value {
    flex: 1;
    text-align: left;
    color: var(--color-primary);
    font-weight: 500;
  }

  .lang-chevron {
    color: var(--color-text-50);
    transition: transform var(--transition-duration-fast) var(--transition-timing-default);
    flex-shrink: 0;
  }

  .lang-chevron.rotated {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    background: var(--color-background-10);
    border: 1px solid color-mix(in srgb, var(--color-separator) 35%, transparent);
    border-radius: 8px;
    padding: var(--space-2);
    list-style: none;
    margin: 0;
    z-index: 50;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .dropdown-enter { transition: opacity 0.15s ease, transform 0.15s ease; }
  .dropdown-enter-start { opacity: 0; transform: translateY(-4px); }
  .dropdown-enter-end { opacity: 1; transform: translateY(0); }
  .dropdown-leave { transition: opacity 0.1s ease; }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-radius: 5px;
    font-size: var(--text-xs);
    color: var(--color-text-50);
    text-decoration: none;
    transition:
      color var(--transition-duration-fast) var(--transition-timing-default),
      background var(--transition-duration-fast) var(--transition-timing-default);
  }

  .lang-option:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-background-50) 60%, transparent);
  }

  .lang-option--active {
    color: var(--color-primary);
  }
</style>
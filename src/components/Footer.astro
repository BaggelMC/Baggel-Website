---
import { socials } from "../content/footerSocials";
import CommunityPopover from "./CommunityPopover.astro";

const navLinks = [
  { label: "Kontakt", href: "/contact" },
  {
    label: "Status",
    href: "https://stats.uptimerobot.com/1ce6JDe7CN",
    external: true,
  },
];

const legalLinks = [
  { label: "Impressum", href: "/imprint" },
  { label: "Privacy Policy", href: "/privacy" },
];

interface Props {
  enableBackground?: boolean;
}

const { enableBackground = true } = Astro.props;

const year = new Date().getFullYear();
---

<footer
  class:list={[
    "bg-background py-6 mt-12 shadow-xl",
    !enableBackground && "border-t-2 border-background-50",
  ]}
>
  <div class="container mx-auto max-w-6xl px-5 text-text-50">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {
          navLinks.map(({ label, href, external }) => (
            <a
              href={href}
              class="hover:underline"
              {...(external && {
                target: "_blank",
                rel: "noopener noreferrer",
              })}
            >
              {label}
            </a>
          ))
        }
        <button
          type="button"
          popovertarget="community-popover"
          class="hover:underline cursor-pointer"
        >
          Community
        </button>
      </nav>

      <div class="flex space-x-4">
        {
          socials.map(({ label, href, viewBox, svg }) => (
            <a
              href={href}
              aria-label={label}
              class="hover:text-primary transition"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="currentColor"
                viewBox={viewBox}
              >
                <Fragment set:html={svg} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <div
      class="mt-4 pt-4 border-t border-background-50 flex flex-col md:flex-row items-center justify-between gap-2 text-sm text-text-100"
    >
      <p>© {year} BaggelMC. Alle Rechte vorbehalten.</p>
      <nav aria-label="Rechtliches" class="flex gap-x-4">
        {
          legalLinks.map(({ label, href }) => (
            <a href={href} class="hover:underline hover:text-text-50">
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <CommunityPopover />
</footer>
---
import { LINKS } from "../config";
import Separator from "./Separator.astro";
---

<footer class="bg-background py-6 mt-12 shadow-xl">

  <!-- <Separator color="text-50" /> -->
  
  <div class="container mx-auto flex flex-col md:flex-row items-center justify-between text-text-50 px-5 max-w-6xl">
    <div class="flex space-x-6 mb-4 md:mb-0">
      <!-- <a href="/imprint" class="hover:underline">Impressum</a> -->
      <a href="/contact" class="hover:underline">Kontakt</a>
      <a href="https://stats.uptimerobot.com/1ce6JDe7CN" class="hover:underline" target="_blank" rel="noopener noreferrer" >Status</a>
    </div>

    <div class="text-sm text-center text-text-100 mb-4 md:mb-0">

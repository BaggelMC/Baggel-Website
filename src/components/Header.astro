---
// @ts-ignore
import logoSrc from "@assets/logo.png?format=webp&w=96&h=96";
// @ts-ignore
import textureDark from "@assets/header-texture-dark.png?format=webp&h=200";
// @ts-ignore
import textureLight from "@assets/header-texture-light.png?format=webp&h=200";

import "../styles/header.css";
import { LINKS } from "../config";

type Icon = keyof typeof icons;
type NavLink = { label: string; href: string; icon?: Icon };
type NavGroup = { label: string; icon?: Icon; children: NavLink[] };
type NavItem = NavLink | NavGroup;

// Lucide-style 24x24 stroke icons (inner SVG markup)
const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>',
  box: '<path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="m3 7 9 5 9-5"/><path d="M12 12v10"/>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  image:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  copy: '<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
};

const discordPath =
  "M81.15,0c-1.2376,2.1973-2.3489,4.4704-3.3591,6.794-9.5975-1.4396-19.3718-1.4396-28.9945,0-.985-2.3236-2.1216-4.5967-3.3591-6.794-9.0166,1.5407-17.8059,4.2431-26.1405,8.0568C2.779,32.5304-1.6914,56.3725.5312,79.8863c9.6732,7.1476,20.5083,12.603,32.0505,16.0884,2.6014-3.4854,4.8998-7.1981,6.8698-11.0623-3.738-1.3891-7.3497-3.1318-10.8098-5.1523.9092-.6567,1.7932-1.3386,2.6519-1.9953,20.281,9.547,43.7696,9.547,64.0758,0,.8587.7072,1.7427,1.3891,2.6519,1.9953-3.4601,2.0457-7.0718,3.7632-10.835,5.1776,1.97,3.8642,4.2683,7.5769,6.8698,11.0623,11.5419-3.4854,22.3769-8.9156,32.0509-16.0631,2.626-27.2771-4.496-50.9172-18.817-71.8548C98.9811,4.2684,90.1918,1.5659,81.1752.0505l-.0252-.0505ZM42.2802,65.4144c-6.2383,0-11.4159-5.6575-11.4159-12.6535s4.9755-12.6788,11.3907-12.6788,11.5169,5.708,11.4159,12.6788c-.101,6.9708-5.026,12.6535-11.3907,12.6535ZM84.3576,65.4144c-6.2637,0-11.3907-5.6575-11.3907-12.6535s4.9755-12.6788,11.3907-12.6788,11.4917,5.708,11.3906,12.6788c-.101,6.9708-5.026,12.6535-11.3906,12.6535Z";

const nav: NavItem[] = [
  { label: "Home", href: "/", icon: "home" },
  {
    label: "Projekte",
    icon: "box",
    children: [{ label: "BuildMC", href: "/projects/buildmc" }],
  },
  {
    label: "Tools",
    icon: "wrench",
    children: [
      { label: "Core-Plugin", href: "/tools/core" },
      { label: "MiniMessage", href: "/tools/minimessage" },
    ],
  },
  { label: "Galerie", href: "/gallery", icon: "image" },
  { label: "Team", href: "/team", icon: "users" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const ariaCurrent = (href: string) => (isCurrent(href) ? "page" : undefined);
const groupActive = (group: NavGroup) =>
  group.children.some((c) => isCurrent(c.href));

const svgAttrs = {
  "aria-hidden": "true",
  focusable: "false",
  xmlns: "http://www.w3.org/2000/svg",
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

<header class="bh">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-999999 focus:bg-background focus:px-4 focus:py-2 focus:text-accent focus:outline-2 focus:outline-accent"
  >
    Zum Inhalt springen
  </a>

  <!-- Texture only covers the header bars; the mobile menu overlays the page below -->
  <div
    class="bh-bg"
    style={`--layer-dark: url(${textureDark}); --layer-light: url(${textureLight});`}
    data-bg-dark={textureDark}
    data-bg-light={textureLight}
  >
    <div class="bg-layer image-rendering-pixelated" data-bg-layer="dark" aria-hidden="true"></div>
    <div class="bg-layer image-rendering-pixelated" data-bg-layer="light" aria-hidden="true"></div>
  </div>

  <div class="bh-inner bh-top">
    <a href="/" class="bh-brand" aria-label="Baggel – Startseite">
      <img src={logoSrc} alt="" class="bh-brand-logo" />
      <span class="bh-brand-text">
        <span class="bh-brand-name">BAGGEL.DE</span>
        <span class="bh-brand-tagline">Minecraft Server Community</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="bh-nav" aria-label="Hauptnavigation">
      <ul data-popup-group>
        {
          nav.map((item, i) =>
            "children" in item ? (
              <li data-dropdown data-popup>
                <button
                  type="button"
                  class:list={["bh-link", groupActive(item) && "is-active"]}
                  aria-expanded="false"
                  aria-controls={`submenu-${i}`}
                >
                  {item.icon && <svg {...svgAttrs} set:html={icons[item.icon]} />}
                  <span>{item.label}</span>
                  <svg {...svgAttrs} class="bh-chevron" set:html={icons.chevron} />
                </button>
                <div id={`submenu-${i}`} class="bh-menu hidden">
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={ariaCurrent(child.href)}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class="bh-link" aria-current={ariaCurrent(item.href)}>
                  {item.icon && <svg {...svgAttrs} set:html={icons[item.icon]} />}
                  <span>{item.label}</span>
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="bh-burger"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <!-- Server bar -->
  <div class="bh-subbar">
    <div class="bh-inner bh-sub">
      <div class="bh-server">
        <span id="bh-status" class="bh-status" data-state="unknown" aria-live="polite">
          <span class="bh-dot" aria-hidden="true"></span>
          <strong id="bh-count"></strong>
          <span id="bh-status-label">Lädt…</span>
        </span>
        <button
          type="button"
          class="bh-ip"
          data-copy-ip={LINKS.server_address}
          aria-label={`Server-Adresse ${LINKS.server_address} kopieren`}
        >
          <span class="bh-ip-prefix">IP</span>
          <span data-copy-label>{LINKS.server_address}</span>
          <svg {...svgAttrs} set:html={icons.copy} />
        </button>
      </div>
      <div class="bh-actions">
        <a href={LINKS.discord} class="bh-cta" target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 126.644 96">
            <path d={discordPath} />
          </svg>
          <span>Discord</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav id="mobile-menu" aria-label="Mobile Navigation" inert class="bh-mobile">
    <ul>
      {
        nav.map((item, i) =>
          "children" in item ? (
            <li data-dropdown>
              <button
                type="button"
                class:list={[groupActive(item) && "is-active"]}
                aria-expanded="false"
                aria-controls={`m-submenu-${i}`}
              >
                {item.icon && <svg {...svgAttrs} set:html={icons[item.icon]} />}
                {item.label}
                <svg {...svgAttrs} class="bh-chevron" set:html={icons.chevron} />
              </button>
              <ul id={`m-submenu-${i}`} class="hidden">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={ariaCurrent(child.href)}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={ariaCurrent(item.href)}>
                {item.icon && <svg {...svgAttrs} set:html={icons[item.icon]} />}
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li>
        <a href={LINKS.discord} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 126.644 96">
            <path d={discordPath} />
          </svg>
          Discord
        </a>
      </li>
    </ul>
  </nav>

  <script>
    import { getServerStatus } from "../scripts/serverStatus";

    /* ---------- Dropdowns (desktop popups + mobile accordions) ---------- */

    const dropdowns = [
      ...document.querySelectorAll<HTMLElement>(".bh [data-dropdown]"),
    ];

    const getParts = (root: HTMLElement) => {
      const button = root.querySelector<HTMLButtonElement>(":scope > button");
      const menu = button
        ? document.getElementById(button.getAttribute("aria-controls") ?? "")
        : null;
      const links = menu
        ? [...menu.querySelectorAll<HTMLAnchorElement>("a[href]")]
        : [];
      return { button, menu, links };
    };

    const setOpen = (root: HTMLElement, open: boolean) => {
      const { button, menu } = getParts(root);
      if (!button || !menu) return;
      button.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("hidden", !open);
    };

    const isOpen = (root: HTMLElement) =>
      getParts(root).button?.getAttribute("aria-expanded") === "true";

    const closeSiblings = (root: HTMLElement) => {
      const group = root.parentElement;
      dropdowns.forEach((d) => {
        if (d !== root && d.parentElement === group) setOpen(d, false);
      });
    };

    dropdowns.forEach((root) => {
      const { button, links } = getParts(root);
      if (!button) return;

      button.addEventListener("click", () => {
        const willOpen = !isOpen(root);
        if (willOpen) closeSiblings(root);
        setOpen(root, willOpen);
      });

      root.addEventListener("keydown", (e: KeyboardEvent) => {
        const target = e.target as HTMLElement;

        if (e.key === "Escape" && isOpen(root)) {
          e.preventDefault();
          e.stopPropagation(); // don't also close the whole mobile menu
          setOpen(root, false);
          button.focus();
          return;
        }

        if (target === button) {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            closeSiblings(root);
            setOpen(root, true);
            links[0]?.focus();
          }
          return;
        }

        const index = links.indexOf(target as HTMLAnchorElement);
        if (index === -1) return;

        switch (e.key) {
          case "ArrowDown":
            e.preventDefault();
            links[(index + 1) % links.length].focus();
            break;
          case "ArrowUp":
            e.preventDefault();
            index === 0 ? button.focus() : links[index - 1].focus();
            break;
          case "Home":
            e.preventDefault();
            links[0].focus();
            break;
          case "End":
            e.preventDefault();
            links[links.length - 1].focus();
            break;
        }
      });
    });

    const popups = dropdowns.filter((d) => d.hasAttribute("data-popup"));
    const closePopups = (except?: Node | null) =>
      popups.forEach((p) => {
        if (!except || !p.contains(except)) setOpen(p, false);
      });

    document.addEventListener("click", (e) => closePopups(e.target as Node));
    document.addEventListener("focusin", (e) => closePopups(e.target as Node));

    /* ---------- Mobile menu ---------- */

    const toggle = document.getElementById(
      "mobile-menu-toggle",
    ) as HTMLButtonElement | null;
    const mobileMenu = document.getElementById("mobile-menu");

    if (toggle && mobileMenu) {
      const setMobileOpen = (open: boolean) => {
        mobileMenu.classList.toggle("is-open", open);
        mobileMenu.inert = !open;
        toggle.setAttribute("aria-expanded", String(open));
      };

      toggle.addEventListener("click", () =>
        setMobileOpen(toggle.getAttribute("aria-expanded") !== "true"),
      );

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          setMobileOpen(false);
          toggle.focus();
        }
      });

      // Close when tapping outside the header (the menu overlays the page)
      document.addEventListener("click", (e) => {
        if (
          toggle.getAttribute("aria-expanded") === "true" &&
          !(e.target as HTMLElement).closest(".bh")
        )
          setMobileOpen(false);
      });

      // Same breakpoint as the burger in header.css
      window.matchMedia("(min-width: 60rem)").addEventListener("change", (e) => {
        if (e.matches) setMobileOpen(false);
      });
    }

    /* ---------- Server bar ---------- */

    const status = document.getElementById("bh-status");
    const count = document.getElementById("bh-count");
    const label = document.getElementById("bh-status-label");

    if (status && count && label) {
      getServerStatus().then((s) => {
        status.dataset.state = !s ? "unknown" : s.online ? "online" : "offline";
        count.textContent = s?.online ? String(s.players) : "";
        label.textContent = !s
          ? "Status unbekannt"
          : s.online
            ? "Spieler online"
            : "Server offline";
      });
    }

    document.querySelectorAll<HTMLButtonElement>("[data-copy-ip]").forEach((btn) => {
      const label = btn.querySelector<HTMLElement>("[data-copy-label]");
      if (!label) return;
      const address = btn.dataset.copyIp ?? "";
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(address);
          label.textContent = "Kopiert!";
          btn.classList.add("is-copied");
        } catch {
          label.textContent = "Fehler";
        }
        setTimeout(() => {
          label.textContent = address;
          btn.classList.remove("is-copied");
        }, 1500);
      });
    });
  </script>
</header>

---
// @ts-ignore
import logoSrc from "../assets/logo.png?format=webp&w=64&h=64";
// @ts-ignore
import textureDark from "../assets/header-texture-dark.png?format=webp&h=200";
// @ts-ignore
import textureLight from "../assets/header-texture-light.png?format=webp&h=200";

type NavLink = { label: string; href: string };
type NavGroup = { label: string; children: NavLink[] };
type NavItem = NavLink | NavGroup;

const nav: NavItem[] = [
  { label: "Home", href: "/" },
  {
    label: "Projekte",
    children: [{ label: "BuildMC", href: "/projects/buildmc" }],
  },
  {
    label: "Tools",
    children: [
      { label: "Core-Plugin", href: "/tools/core" },
      { label: "MiniMessage", href: "/tools/minimessage" },
    ],
  },
  { label: "Gallerie", href: "/gallery" },
  { label: "Team", href: "/team" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const ariaCurrent = (href: string) => (isCurrent(href) ? "page" : undefined);

const showThemeToggle = false

const ring =
  "rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<header class="relative text-text shadow-lg">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-999999 focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-accent focus:outline-2 focus:outline-accent"
  >
    Zum Inhalt springen
  </a>

  <div
    class="relative"
    style={`--layer-dark: url(${textureDark}); --layer-light: url(${textureLight});`}
    data-bg-dark={textureDark}
    data-bg-light={textureLight}
  >
    <div
      class="bg-layer image-rendering-pixelated"
      data-bg-layer="dark"
      aria-hidden="true"
    >
    </div>
    <div
      class="bg-layer image-rendering-pixelated"
      data-bg-layer="light"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-header-1/20 to-header-2/20 pointer-events-none"
    >
    </div>

    <div
      class="relative max-w-6xl mx-auto flex justify-between items-center p-(--space-4)"
    >
      <a
        href="/"
        class:list={[
          "flex items-center gap-2 text-lg font-bold font-minecraft z-2",
          ring,
        ]}
      >
        <img src={logoSrc} alt="" class="h-[2em] w-auto" />
        Baggel
      </a>

      <div class="flex items-center gap-4">
        <!-- Desktop Navigation -->
        <nav class="hidden md:block" aria-label="Hauptnavigation">
          <ul class="flex space-x-6 items-center" data-popup-group>
            {
              nav.map((item, i) =>
                "children" in item ? (
                  <li class="relative" data-dropdown data-popup>
                    <button
                      type="button"
                      class:list={[
                        "flex items-center gap-1 hover:text-accent transition",
                        ring,
                      ]}
                      aria-expanded="false"
                      aria-controls={`submenu-${i}`}
                    >
                      {item.label}
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4 transition-transform"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"
                        />
                      </svg>
                    </button>

                    <div
                      id={`submenu-${i}`}
                      class="hidden absolute left-0 mt-2 rounded-2xl p-px bg-linear-to-br from-background via-accent to-background z-999999"
                    >
                      <ul class="bg-background rounded-[inherit] overflow-hidden">
                        {item.children.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              aria-current={ariaCurrent(child.href)}
                              class="block px-4 py-2 hover:bg-accent-light hover:text-accent focus-visible:bg-accent-light focus-visible:text-accent focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent aria-[current=page]:text-accent"
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ) : (
                  <li>
                    <a
                      href={item.href}
                      aria-current={ariaCurrent(item.href)}
                      class:list={[
                        "hover:text-accent transition aria-[current=page]:text-accent",
                        ring,
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </nav>

        <!-- Theme Toggle -->
        {
          showThemeToggle && (
          <button
            id="theme-toggle"
            type="button"
            class:list={[
              "theme-toggle p-2 text-text-50 hover:text-accent transition",
              ring,
            ]}
            aria-label="Zum hellen Design wechseln"
          >
            <svg
              class="icon-sun h-5 w-5"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
              ></path>
            </svg>
            <svg
              class="icon-moon h-5 w-5"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
              ></path>
            </svg>
          </button>
          )
        }

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class:list={["md:hidden flex flex-col gap-1 p-2", ring]}
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menü"
        >
          <span class="block w-6 h-0.5 bg-current" aria-hidden="true"></span>
          <span class="block w-6 h-0.5 bg-current" aria-hidden="true"></span>
          <span class="block w-6 h-0.5 bg-current" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile Navigation"
    inert
    class="md:hidden max-h-0 overflow-hidden transition-all duration-300 motion-reduce:transition-none bg-background/95 backdrop-blur-md"
  >
    <ul class="flex flex-col p-4 space-y-2 border-t border-background-50">
      {
        nav.map((item, i) =>
          "children" in item ? (
            <li data-dropdown>
              <button
                type="button"
                class:list={[
                  "w-full flex justify-between items-center py-2",
                  ring,
                ]}
                aria-expanded="false"
                aria-controls={`m-submenu-${i}`}
              >
                {item.label}
                <svg
                  aria-hidden="true"
                  focusable="false"
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 transition-transform"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>
              <ul id={`m-submenu-${i}`} class="hidden pl-4">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={ariaCurrent(child.href)}
                      class:list={[
                        "block py-2 aria-[current=page]:text-accent",
                        ring,
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={ariaCurrent(item.href)}
                class:list={[
                  "block py-2 aria-[current=page]:text-accent",
                  ring,
                ]}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>

  <script>
    const dropdowns = [
      ...document.querySelectorAll<HTMLElement>("[data-dropdown]"),
    ];

    const getParts = (root: HTMLElement) => {
      const button = root.querySelector<HTMLButtonElement>(":scope > button");
      const menu = button
        ? document.getElementById(button.getAttribute("aria-controls") ?? "")
        : null;
      const links = menu
        ? [...menu.querySelectorAll<HTMLAnchorElement>("a[href]")]
        : [];
      return { button, menu, links };
    };

    const setOpen = (root: HTMLElement, open: boolean) => {
      const { button, menu } = getParts(root);
      if (!button || !menu) return;
      button.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("hidden", !open);
      button.querySelector("svg")?.classList.toggle("rotate-180", open);
    };

    const isOpen = (root: HTMLElement) =>
      getParts(root).button?.getAttribute("aria-expanded") === "true";

    const closeSiblings = (root: HTMLElement) => {
      const group = root.parentElement;
      dropdowns.forEach((d) => {
        if (d !== root && d.parentElement === group) setOpen(d, false);
      });
    };

    dropdowns.forEach((root) => {
      const { button, links } = getParts(root);
      if (!button) return;

      button.addEventListener("click", () => {
        const willOpen = !isOpen(root);
        if (willOpen) closeSiblings(root);
        setOpen(root, willOpen);
      });

      root.addEventListener("keydown", (e: KeyboardEvent) => {
        const target = e.target as HTMLElement;

        if (e.key === "Escape" && isOpen(root)) {
          e.preventDefault();
          e.stopPropagation(); // don't also close the whole mobile menu
          setOpen(root, false);
          button.focus();
          return;
        }

        if (target === button) {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            closeSiblings(root);
            setOpen(root, true);
            links[0]?.focus();
          }
          return;
        }

        const index = links.indexOf(target as HTMLAnchorElement);
        if (index === -1) return;

        switch (e.key) {
          case "ArrowDown":
            e.preventDefault();
            links[(index + 1) % links.length].focus();
            break;
          case "ArrowUp":
            e.preventDefault();
            index === 0 ? button.focus() : links[index - 1].focus();
            break;
          case "Home":
            e.preventDefault();
            links[0].focus();
            break;
          case "End":
            e.preventDefault();
            links[links.length - 1].focus();
            break;
        }
      });
    });

    const popups = dropdowns.filter((d) => d.hasAttribute("data-popup"));
    const closePopups = (except?: Node | null) =>
      popups.forEach((p) => {
        if (!except || !p.contains(except)) setOpen(p, false);
      });

    document.addEventListener("click", (e) => closePopups(e.target as Node));
    document.addEventListener("focusin", (e) => closePopups(e.target as Node));

    // Same key as Starlight, so the choice is shared with the docs
    const THEME_KEY = "starlight-theme";
    const themeToggle = document.getElementById("theme-toggle");

    const syncThemeLabel = () => {
      const isLight = document.documentElement.dataset.theme === "light";
      themeToggle?.setAttribute(
        "aria-label",
        isLight ? "Zum dunklen Design wechseln" : "Zum hellen Design wechseln",
      );
    };

    const currentTheme = () =>
      document.documentElement.dataset.theme === "light" ? "light" : "dark";
    const otherTheme = () => (currentTheme() === "light" ? "dark" : "light");

    // Load a theme's background image on demand (deduplicated, cached)
    // Every element with themed background layers (page background, header texture)
    const bgRoots = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-bg-dark][data-bg-light]",
      ),
    ];
    const bgLoads = new Map<HTMLElement, Promise<void>>();
    const loadBackground = (theme: "light" | "dark"): Promise<void> =>
      Promise.all(
        bgRoots.map((root) => {
          const layer = root.querySelector<HTMLElement>(
            `[data-bg-layer="${theme}"]`,
          );
          const url =
            theme === "light" ? root.dataset.bgLight : root.dataset.bgDark;
          if (!layer || !url || layer.classList.contains("is-loaded")) return;

          let load = bgLoads.get(layer);
          if (!load) {
            const img = new Image();
            img.src = url;
            load = img
              .decode()
              .catch(() => {})
              .then(() => layer.classList.add("is-loaded"));
            bgLoads.set(layer, load);
          }
          return load;
        }),
      ).then(() => {});

    // Start fetching as soon as the user shows intent
    ["pointerenter", "focus"].forEach((ev) =>
      themeToggle?.addEventListener(ev, () => loadBackground(otherTheme())),
    );

    themeToggle?.addEventListener("click", async () => {
      const current = currentTheme();
      const next = otherTheme();

      // Keep the visible image applied while it fades out
      bgRoots.forEach((root) =>
        root
          .querySelector(`[data-bg-layer="${current}"]`)
          ?.classList.add("is-loaded"),
      );

      // Wait for the new image so the crossfade doesn't fade to nothing
      // (capped, so a slow connection never blocks the toggle)
      await Promise.race([
        loadBackground(next),
        new Promise((resolve) => setTimeout(resolve, 1500)),
      ]);

      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem(THEME_KEY, next);
      } catch {}
      syncThemeLabel();
    });

    syncThemeLabel();

    /* ---------- Mobile menu ---------- */

    const toggle = document.getElementById(
      "mobile-menu-toggle",
    ) as HTMLButtonElement | null;
    const mobileMenu = document.getElementById("mobile-menu");

    if (toggle && mobileMenu) {
      const setMobileOpen = (open: boolean) => {
        mobileMenu.classList.toggle("max-h-[100vh]", open);
        mobileMenu.inert = !open;
        toggle.setAttribute("aria-expanded", String(open));
      };

      toggle.addEventListener("click", () =>
        setMobileOpen(toggle.getAttribute("aria-expanded") !== "true"),
      );

      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          toggle.getAttribute("aria-expanded") === "true"
        ) {
          setMobileOpen(false);
          toggle.focus();
        }
      });

      // Don't leave the mobile menu "open" when resizing up to desktop
      window
        .matchMedia("(min-width: 48rem)")
        .addEventListener("change", (e) => {
          if (e.matches) setMobileOpen(false);
        });
    }
  </script>
</header>
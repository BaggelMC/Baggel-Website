---
const community = {
  title: "Community",
  intro: "Webseiten aus unserer Community.",
  close: "Schließen",
  loadError: "Die Badges konnten gerade nicht geladen werden.",
  embedTitle: "Auf deiner Webseite einbinden",
};

const embedSnippet = `<script type="module" src="https://baggel.de/embed.js"></script>

<community-badges></community-badges>`;
---

<div
  id="community-popover"
  popover
  role="dialog"
  aria-labelledby="community-title"
  class="community-popover bg-background text-text-50 border border-background-50 rounded-2xl shadow-2xl"
>
  <div class="flex items-start justify-between gap-6 mb-5">
    <div>
      <h2 id="community-title" class="text-lg font-semibold">
        {community.title}
      </h2>
      <p class="text-sm text-text-100">{community.intro}</p>
    </div>
    <button
      type="button"
      popovertarget="community-popover"
      popovertargetaction="hide"
      aria-label={community.close}
      class="hover:text-primary transition cursor-pointer"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 4l12 12M16 4L4 16"></path>
      </svg>
    </button>
  </div>

  <community-badges>
    <p class="text-sm text-text-100">{community.loadError}</p>
  </community-badges>

  <details class="mt-6 text-sm">
    <summary class="cursor-pointer hover:text-primary transition"
      >{community.embedTitle}</summary
    >
    <pre
      class="mt-3 overflow-x-auto rounded-lg bg-black/20 p-3 text-xs"><code>{embedSnippet}</code></pre>
  </details>
</div>

<script is:inline type="module" src="/embed.js"></script>

<style is:global>
  .community-popover {
    inset: 0;
    margin: auto;
    width: min(34rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: 1.5rem;

    opacity: 0;
    transform: translateY(1rem) scale(0.96);
    transition:
      opacity 0.2s ease,
      transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.25),
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .community-popover:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .community-popover:popover-open {
      opacity: 0;
      transform: translateY(1rem) scale(0.96);
    }
  }

  .community-popover::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }
  .community-popover:popover-open::backdrop {
    opacity: 1;
  }
  @starting-style {
    .community-popover:popover-open::backdrop {
      opacity: 0;
    }
  }

  .community-popover community-badges {
    --cb-gap: 0.75rem;
    --cb-justify: center;
  }
  .community-popover community-badges::part(badge) {
    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }
  .community-popover community-badges::part(badge):hover {
    transform: translateY(-2px) rotate(-2deg);
    filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.35));
  }

  @media (prefers-reduced-motion: reduce) {
    .community-popover,
    .community-popover::backdrop,
    .community-popover community-badges::part(badge) {
      transition: none;
    }
    .community-popover community-badges::part(badge):hover {
      transform: none;
    }
  }
</style>

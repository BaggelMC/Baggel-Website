---
import type { Game, ConceptGame } from "../content/games";
import { getGameImages, getGameIcon } from "../scripts/index/gameImages";
import TextPill from "./TextPill.astro";

interface Props {
  game: Game | ConceptGame;
}

const { game } = Astro.props;

const available = "image" in game;
const images = "image" in game ? getGameImages(game.image) : [];
const icon = "icon" in game ? getGameIcon(game.icon) : undefined;
---

<div
  class:list={[
    "tilt-card game-card w-full sm:w-[45%] max-w-xl relative rounded-2xl overflow-hidden bg-background-10 transition-colors duration-500",
    available
      ? "border border-background-50 shadow-lg"
      : "game-card--concept border-2 border-dashed border-background-50",
  ]}
>
  <div class="cursor-glow"></div>
  {
    available && (
      <>
        <span class="corner corner-tl" />
        <span class="corner corner-br" />
      </>
    )
  }

  <div
    class:list={[
      "relative z-10 h-52 sm:h-56 overflow-hidden",
      !available && "blueprint-grid flex items-center justify-center",
    ]}
  >
    {
      "image" in game ? (
        <div class="progressive-img-wrapper w-full h-full">
          <img
            src={images[0]}
            data-images={JSON.stringify(images)}
            alt={game.imageAlt}
            loading="lazy"
            decoding="async"
            class="progressive-img w-full h-full object-cover"
          />
        </div>
      ) : (
        <>
          <pre class="code-typer" aria-hidden="true" />
          <img
            src={icon}
            alt={`${game.name} Icon`}
            class="icon-visual w-16 h-16 object-contain"
          />
        </>
      )
    }
    <div class="absolute top-4 right-4 z-2">
      <TextPill content={available ? "Verfügbar" : "In Entwicklung"} ></TextPill>
    </div>
  </div>

  <div class="relative z-10 p-6 text-left space-y-3">
    <h3 class="text-xl font-bold text-primary">{game.name}</h3>
    <p class="text-text-50">{game.description}</p>
  </div>

  {available && <div class="card-shine" />}
</div>

<style>
  .badge {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 18%, rgb(0 0 0 / 35%));
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .game-card {
    isolation: isolate;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s ease,
      border-color 0.4s ease;
    will-change: transform;
  }

  .game-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 24px 60px -22px
      color-mix(in srgb, var(--color-accent) 60%, transparent);
  }

  .cursor-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      circle at var(--glow-x, 50%) var(--glow-y, 15%),
      color-mix(in srgb, var(--color-accent) 10%, transparent),
      transparent 65%
    );
  }

  .game-card:hover .cursor-glow {
    opacity: 1;
  }

  .corner {
    position: absolute;
    z-index: 20;
    width: 22px;
    height: 22px;
    border: 2px solid var(--color-accent);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .corner-tl {
    top: 10px;
    left: 10px;
    border-right: none;
    border-bottom: none;
    transform: translate(6px, 6px);
  }
  .corner-br {
    bottom: 10px;
    right: 10px;
    border-left: none;
    border-top: none;
    transform: translate(-6px, -6px);
  }
  .game-card:hover .corner {
    opacity: 0.9;
    transform: translate(0, 0);
  }

  .card-shine {
    position: absolute;
    inset: -25% -70%;
    z-index: 30;
    pointer-events: none;
    background: linear-gradient(
      75deg,
      transparent 42%,
      color-mix(in srgb, white 8%, transparent) 50%,
      transparent 58%
    );
    transform: translateX(-120%);
    transition: transform 0.9s ease;
  }
  .game-card:hover .card-shine {
    transform: translateX(45%);
  }

  .blueprint-grid {
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-accent) 20%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-accent) 20%, transparent) 1px,
        transparent 1px
      );
    background-size: 20px 20px;
    background-position: center;
  }

  .icon-visual {
    position: relative;
    z-index: 1;
    transition: transform 0.4s ease;
  }
  .game-card:hover .icon-visual {
    transform: translateY(-4px) rotate(-4deg) scale(1.08);
  }

  .code-typer {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 16px 18px;
    overflow: hidden;
    pointer-events: none;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono",
      monospace;
    font-size: 10.5px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
    text-align: left;
    color: color-mix(in srgb, var(--color-accent) 70%, transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .game-card--concept:hover .code-typer {
    opacity: 0.55;
  }
  .code-typer.is-typing::after {
    content: "▌";
    margin-left: 1px;
    animation: code-cursor-blink 1s steps(1) infinite;
  }
  @keyframes code-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .game-card:hover .progressive-img {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt-card,
    .card-shine,
    .icon-visual,
    .progressive-img,
    .corner {
      transition: none !important;
      transform: none !important;
    }
    .code-typer {
      display: none;
    }
  }
</style>
